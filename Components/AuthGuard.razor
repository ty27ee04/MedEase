@using HealthTech.Services
@inject UserSession Session
@inject NavigationManager Nav

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    
    [Parameter]
    public bool RequireAuth { get; set; } = true;
    
    [Parameter]
    public string? RequireRole { get; set; }

    protected override void OnInitialized()
    {
        // Subscribe to session changes to re-render when login state changes
        Session.OnChange += StateHasChanged;
        
        // Check authentication
        CheckAuthentication();
    }
    
    protected override void OnParametersSet()
    {
        CheckAuthentication();
    }
    
    private void CheckAuthentication()
    {
        if (RequireAuth && !Session.IsLoggedIn)
        {
            // Redirect to login if not authenticated
            Nav.NavigateTo("/login", true);
            return;
        }
        
        if (!string.IsNullOrEmpty(RequireRole) && Session.IsLoggedIn)
        {
            if (!Session.IsInRole(RequireRole))
            {
                // Redirect to home if user doesn't have required role
                Nav.NavigateTo("/", true);
                return;
            }
        }
    }
    
    public void Dispose()
    {
        Session.OnChange -= StateHasChanged;
    }
}

@if (RequireAuth && !Session.IsLoggedIn)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3">Checking authentication...</p>
    </div>
}
else if (!string.IsNullOrEmpty(RequireRole) && !Session.IsInRole(RequireRole))
{
    <div class="alert alert-danger mt-5 mx-3">
        <h4>Access Denied</h4>
        <p>You don't have permission to access this page. Required role: @RequireRole</p>
        <a href="/" class="btn btn-primary">Go to Home</a>
    </div>
}
else
{
    @ChildContent
}
