@page "/patient-records"
@rendermode InteractiveServer
@using HealthTech.Services
@using Microsoft.AspNetCore.Components
@inject ApiService ApiService


<PageTitle>Patient Records</PageTitle>

<div class="container-fluid mt-3">
    <h1>📋 Patient Medical Records</h1>
    <p>Search patients, view information, and manage hierarchical medical records</p>

    <!-- Patient Search Section -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <strong>🔍 Patient Search</strong>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-12">
                    <div class="input-group mb-3">
                        <span class="input-group-text">Search</span>
                        <input type="text" class="form-control" 
                               placeholder="Type patient name or ID to search..." 
                               @bind="patientSearchQuery"
                               @bind:event="oninput"
                               @onkeyup="FilterPatients"
                               @onfocus="() => showPatientList = true" />
                        @if (!string.IsNullOrEmpty(patientSearchQuery))
                        {
                            <button class="btn btn-outline-secondary" @onclick="ClearPatientSearch">✖</button>
                        }
                        <button class="btn btn-primary" @onclick="ShowAllPatients">
                            👥 View All Patients
                        </button>
                    </div>
                    
                    @if (showPatientList && filteredPatients.Count > 0)
                    {
                        <div class="list-group" style="max-height: 400px; overflow-y: auto; border: 1px solid #ddd; border-radius: 4px;">
                            @foreach (var patient in filteredPatients.Take(showAllPatientsMode ? 1000 : 10))
                            {
                                <button type="button" 
                                        class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(selectedPatientId == patient.UserID ? "active" : "")"
                                        @onclick="() => SelectPatient(patient)">
                                    <div>
                                        <strong>@patient.Name</strong>
                                        <br />
                                        <small class="@(selectedPatientId == patient.UserID ? "text-white" : "text-muted")">
                                            ID: @patient.UserID | Email: @patient.Email | Phone: @patient.Phone
                                        </small>
                                    </div>
                                    @if (selectedPatientId == patient.UserID)
                                    {
                                        <span class="badge bg-light text-primary">✓ Selected</span>
                                    }
                                </button>
                            }
                            @if (filteredPatients.Count > 10 && !showAllPatientsMode)
                            {
                                <div class="list-group-item text-center text-muted">
                                    <small>Showing 10 of @filteredPatients.Count patients. Type more to narrow results or click "View All Patients".</small>
                                </div>
                            }
                        </div>
                    }
                    else if (showPatientList && !string.IsNullOrEmpty(patientSearchQuery) && filteredPatients.Count == 0)
                    {
                        <div class="alert alert-info mb-0">
                            No patients found matching "@patientSearchQuery"
                        </div>
                    }
                    else if (string.IsNullOrEmpty(patientSearchQuery))
                    {
                        <div class="alert alert-info mb-0">
                            <i class="bi bi-info-circle"></i> Start typing to search for patients...
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (selectedPatientId > 0 && currentPatient != null)
    {
        <!-- Patient Information Card -->
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <strong>👤 Patient Information</strong>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-2">
                        <strong>Name:</strong> @currentPatient.Name
                    </div>
                    <div class="col-md-1">
                        <strong>ID:</strong> @currentPatient.UserID
                    </div>
                    <div class="col-md-3">
                        <strong>Email:</strong> @currentPatient.Email
                    </div>
                    <div class="col-md-2">
                        <strong>Phone:</strong> @currentPatient.Phone
                    </div>
                    <div class="col-md-1">
                        <strong>Age:</strong> @(currentPatient.Age?.ToString() ?? "N/A")
                    </div>
                    <div class="col-md-3">
                        <strong>Gender:</strong> @currentPatient.Gender
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8">
                <!-- Date-Based List View -->
                    <div class="card mb-3">
                        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                            <strong>📑 Records List (by Date)</strong>
                            <div>
                                <input type="text" class="form-control form-control-sm d-inline-block" 
                                       style="width: 200px;" 
                                       placeholder="Filter records..." 
                                       @bind="recordSearchQuery"
                                       @bind:event="oninput"
                                       @onkeyup="FilterRecords" />
                            </div>
                        </div>
                        <div class="card-body">
                            <!-- Date Navigation -->
                            <div class="mb-3 d-flex flex-wrap gap-1">
                                @foreach (var date in GetUniqueDates())
                                {
                                    var count = GetRecordCountByDate(date);
                                    <button class="btn btn-sm @(selectedDate == date ? "btn-primary" : "btn-outline-primary")" 
                                            @onclick="() => FilterByDate(date)">
                                        @date.ToString("MMM dd, yyyy") (@count)
                                    </button>
                                }
                                <button class="btn btn-sm @(selectedDate == null ? "btn-success" : "btn-outline-success")" 
                                        @onclick="ShowAllRecords">All</button>
                            </div>

                            <!-- Records List -->
                            @if (filteredRecords.Count == 0)
                            {
                                <div class="alert alert-info">No records found</div>
                            }
                            else
                            {
                                <div class="list-group">
                                    @* Show root-level records (folders and standalone files) sorted by date *@
                                    @foreach (var record in filteredRecords.Where(r => !r.InFolder.HasValue).OrderByDescending(r => r.CreatedAt))
                                    {
                                        <div class="list-group-item @(editingRecordId == record.RecordID ? "border-primary" : "") @(selectedRecordId == record.RecordID ? "border-success border-2" : "") clickable-record" 
                                             @onclick="() => HandleRecordClick(record)"
                                             style="cursor: pointer;">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div class="flex-grow-1">
                                                        @if (editingRecordId == record.RecordID)
                                                        {
                                                            <!-- Edit Mode -->
                                                            <div class="mb-2" @onclick:stopPropagation="true">
                                                                <input class="form-control mb-2" @bind="editingTitle" placeholder="Title" />
                                                                <textarea class="form-control mb-2" @bind="editingDetails" rows="3" placeholder="Details"></textarea>
                                                                @if (availableFolders.Count > 0)
                                                                {
                                                                    <select class="form-control" @bind="editingFolderIdString">
                                                                        <option value="">-- Not in any folder --</option>
                                                                        @foreach (var folder in GetEditableParentFolders(record.RecordID))
                                                                        {
                                                                            <option value="@folder.RecordID">
                                                                                📂 @(!string.IsNullOrEmpty(folder.FolderName) ? folder.FolderName : folder.Title)
                                                                            </option>
                                                                        }
                                                                    </select>
                                                                    <small class="text-muted d-block">Change folder location</small>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <!-- View Mode -->
                                                            <div class="d-flex align-items-center mb-1">
                                                                @if (record.RecordType == "Folder")
                                                                {
                                                                    <span class="me-2">
                                                                        @(expandedFolders.Contains(record.RecordID) ? "📂" : "📁")
                                                                    </span>
                                                                }
                                                                <span class="badge @(record.RecordType == "Folder" ? "bg-warning text-dark" : "bg-info") me-2">
                                                                    @(record.RecordType == "Folder" ? "Folder" : "File")
                                                                </span>
                                                                @if (record.RecordType == "Folder" && !string.IsNullOrEmpty(record.FolderName))
                                                                {
                                                                    <h6 class="mb-0 text-primary fw-bold">@record.FolderName</h6>
                                                                    <span class="mx-2 text-muted">|</span>
                                                                }
                                                                <h6 class="mb-0">@record.Title</h6>
                                                            </div>
                                                            @if (!string.IsNullOrEmpty(record.Details))
                                                            {
                                                                <p class="mb-1 text-muted small">@record.Details</p>
                                                            }
                                                            <div class="d-flex justify-content-between align-items-center">
                                                                <small class="text-muted">
                                                                    ID: @record.RecordID 
                                                                    @if (record.RecordType == "Folder")
                                                                    {
                                                                        var childCount = GetChildCount(record.RecordID);
                                                                        <span class="badge bg-secondary ms-2">@childCount file(s)</span>
                                                                    }
                                                                    @if (record.InFolder.HasValue)
                                                                    {
                                                                        <text>| In Folder: @record.InFolder</text>
                                                                    }
                                                                </small>
                                                                <div class="text-end">
                                                                    <small class="text-muted d-block">Created: @record.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                                                                    @if (Math.Abs((record.UpdatedAt - record.CreatedAt).TotalSeconds) > 1)
                                                                    {
                                                                        <small class="text-warning d-block">Updated: @record.UpdatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                            </div>
                                            <div class="ms-2" @onclick:stopPropagation="true">
                                                @if (editingRecordId == record.RecordID)
                                                {
                                                    <button class="btn btn-sm btn-success me-1" @onclick="SaveEdit">💾 Save</button>
                                                    <button class="btn btn-sm btn-secondary" @onclick="CancelEdit">✖ Cancel</button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => StartEdit(record)">✏️ Edit</button>
                                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteRecord(record.RecordID)">🗑️</button>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    @* If it's a folder and expanded, show its files directly below *@
                                        @if (record.RecordType == "Folder" && expandedFolders.Contains(record.RecordID))
                                        {
                                            @foreach (var childFile in allRecords.Where(r => r.InFolder == record.RecordID).OrderByDescending(r => r.CreatedAt))
                                            {
                                                <div class="list-group-item @(editingRecordId == childFile.RecordID ? "border-primary" : "") @(selectedRecordId == childFile.RecordID ? "border-success border-2" : "") clickable-record" 
                                                     @onclick="() => HandleRecordClick(childFile)"
                                                     style="cursor: pointer; margin-left: 30px; border-left: 3px solid #ffc107;">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <div class="flex-grow-1">
                                                            @if (editingRecordId == childFile.RecordID)
                                                            {
                                                                <!-- Edit Mode -->
                                                                <div class="mb-2" @onclick:stopPropagation="true">
                                                                    <input class="form-control mb-2" @bind="editingTitle" placeholder="Title" />
                                                                    <textarea class="form-control mb-2" @bind="editingDetails" rows="3" placeholder="Details"></textarea>
                                                                    @if (availableFolders.Count > 0)
                                                                    {
                                                                        <select class="form-control" @bind="editingFolderIdString">
                                                                            <option value="">-- Not in any folder --</option>
                                                                            @foreach (var folder in GetEditableParentFolders(childFile.RecordID))
                                                                            {
                                                                                <option value="@folder.RecordID">
                                                                                    📂 @(!string.IsNullOrEmpty(folder.FolderName) ? folder.FolderName : folder.Title)
                                                                                </option>
                                                                            }
                                                                        </select>
                                                                        <small class="text-muted d-block">Change folder location</small>
                                                                    }
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <!-- View Mode -->
                                                                <div class="d-flex align-items-center mb-1">
                                                                    @if (childFile.RecordType == "Folder")
                                                                    {
                                                                        <span class="me-2">
                                                                            @(expandedFolders.Contains(childFile.RecordID) ? "📂" : "📁")
                                                                        </span>
                                                                    }
                                                                    <span class="badge @(childFile.RecordType == "Folder" ? "bg-warning text-dark" : "bg-info") me-2">
                                                                        @(childFile.RecordType == "Folder" ? "Folder" : "File")
                                                                    </span>
                                                                    @if (childFile.RecordType == "Folder" && !string.IsNullOrEmpty(childFile.FolderName))
                                                                    {
                                                                        <h6 class="mb-0 text-primary fw-bold">@childFile.FolderName</h6>
                                                                        <span class="mx-2 text-muted">|</span>
                                                                    }
                                                                    <h6 class="mb-0">@childFile.Title</h6>
                                                                </div>
                                                                @if (!string.IsNullOrEmpty(childFile.Details))
                                                                {
                                                                    <p class="mb-1 text-muted small">@childFile.Details</p>
                                                                }
                                                                <div class="d-flex justify-content-between align-items-center">
                                                                    <small class="text-muted">
                                                                        ID: @childFile.RecordID
                                                                        @if (childFile.RecordType == "Folder")
                                                                        {
                                                                            var childCount = GetChildCount(childFile.RecordID);
                                                                            <span class="badge bg-secondary ms-2">@childCount file(s)</span>
                                                                        }
                                                                        @if (childFile.InFolder.HasValue)
                                                                        {
                                                                            <text>| In Folder: @childFile.InFolder</text>
                                                                        }
                                                                    </small>
                                                                    <div class="text-end">
                                                                        <small class="text-muted d-block">Created: @childFile.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                                                                        @if (Math.Abs((childFile.UpdatedAt - childFile.CreatedAt).TotalSeconds) > 1)
                                                                        {
                                                                            <small class="text-warning d-block">Updated: @childFile.UpdatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                        <div class="ms-2" @onclick:stopPropagation="true">
                                                            @if (editingRecordId == childFile.RecordID)
                                                            {
                                                                <button class="btn btn-sm btn-success me-1" @onclick="SaveEdit">💾 Save</button>
                                                                <button class="btn btn-sm btn-secondary" @onclick="CancelEdit">✖ Cancel</button>
                                                            }
                                                            else
                                                            {
                                                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => StartEdit(childFile)">✏️ Edit</button>
                                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteRecord(childFile.RecordID)">🗑️</button>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                
                                                @* If this child is also a folder and expanded, show ITS children (recursive nesting) *@
                                                @if (childFile.RecordType == "Folder" && expandedFolders.Contains(childFile.RecordID))
                                                {
                                                    @foreach (var nestedChild in allRecords.Where(r => r.InFolder == childFile.RecordID).OrderByDescending(r => r.CreatedAt))
                                                    {
                                                        <div class="list-group-item @(editingRecordId == nestedChild.RecordID ? "border-primary" : "") @(selectedRecordId == nestedChild.RecordID ? "border-success border-2" : "") clickable-record" 
                                                             @onclick="() => HandleRecordClick(nestedChild)"
                                                             style="cursor: pointer; margin-left: 60px; border-left: 3px solid #17a2b8;">
                                                            <div class="d-flex justify-content-between align-items-start">
                                                                <div class="flex-grow-1">
                                                                    @if (editingRecordId == nestedChild.RecordID)
                                                                    {
                                                                        <!-- Edit Mode -->
                                                                        <div class="mb-2" @onclick:stopPropagation="true">
                                                                            <input class="form-control mb-2" @bind="editingTitle" placeholder="Title" />
                                                                            <textarea class="form-control mb-2" @bind="editingDetails" rows="3" placeholder="Details"></textarea>
                                                                            @if (availableFolders.Count > 0)
                                                                            {
                                                                                <select class="form-control" @bind="editingFolderIdString">
                                                                                    <option value="">-- Not in any folder --</option>
                                                                                    @foreach (var folder in GetEditableParentFolders(nestedChild.RecordID))
                                                                                    {
                                                                                        <option value="@folder.RecordID">
                                                                                            📂 @(!string.IsNullOrEmpty(folder.FolderName) ? folder.FolderName : folder.Title)
                                                                                        </option>
                                                                                    }
                                                                                </select>
                                                                                <small class="text-muted d-block">Change folder location</small>
                                                                            }
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <!-- View Mode -->
                                                                        <div class="d-flex align-items-center mb-1">
                                                                            @if (nestedChild.RecordType == "Folder")
                                                                            {
                                                                                <span class="me-2">
                                                                                    @(expandedFolders.Contains(nestedChild.RecordID) ? "📂" : "📁")
                                                                                </span>
                                                                            }
                                                                            <span class="badge @(nestedChild.RecordType == "Folder" ? "bg-warning text-dark" : "bg-info") me-2">
                                                                                @(nestedChild.RecordType == "Folder" ? "Folder" : "File")
                                                                            </span>
                                                                            @if (nestedChild.RecordType == "Folder" && !string.IsNullOrEmpty(nestedChild.FolderName))
                                                                            {
                                                                                <h6 class="mb-0 text-primary fw-bold">@nestedChild.FolderName</h6>
                                                                                <span class="mx-2 text-muted">|</span>
                                                                            }
                                                                            <h6 class="mb-0">@nestedChild.Title</h6>
                                                                        </div>
                                                                        @if (!string.IsNullOrEmpty(nestedChild.Details))
                                                                        {
                                                                            <p class="mb-1 text-muted small">@nestedChild.Details</p>
                                                                        }
                                                                        <div class="d-flex justify-content-between align-items-center">
                                                                            <small class="text-muted">
                                                                                ID: @nestedChild.RecordID
                                                                                @if (nestedChild.RecordType == "Folder")
                                                                                {
                                                                                    var nestedCount = GetChildCount(nestedChild.RecordID);
                                                                                    <span class="badge bg-secondary ms-2">@nestedCount file(s)</span>
                                                                                }
                                                                                @if (nestedChild.InFolder.HasValue)
                                                                                {
                                                                                    <text>| In Folder: @nestedChild.InFolder</text>
                                                                                }
                                                                            </small>
                                                                            <div class="text-end">
                                                                                <small class="text-muted d-block">Created: @nestedChild.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                                                                                @if (Math.Abs((nestedChild.UpdatedAt - nestedChild.CreatedAt).TotalSeconds) > 1)
                                                                                {
                                                                                    <small class="text-warning d-block">Updated: @nestedChild.UpdatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                                                                                }
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                </div>
                                                                <div class="ms-2" @onclick:stopPropagation="true">
                                                                    @if (editingRecordId == nestedChild.RecordID)
                                                                    {
                                                                        <button class="btn btn-sm btn-success me-1" @onclick="SaveEdit">💾 Save</button>
                                                                        <button class="btn btn-sm btn-secondary" @onclick="CancelEdit">✖ Cancel</button>
                                                                    }
                                                                    else
                                                                    {
                                                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => StartEdit(nestedChild)">✏️ Edit</button>
                                                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteRecord(nestedChild.RecordID)">🗑️</button>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            }
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </div>
            </div>

            <div class="col-md-4">
                <!-- Add New Record -->
                <div class="card mb-3">
                    <div class="card-header bg-warning">
                        <strong>➕ Add New Record</strong>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Record Type</label>
                            <select class="form-control" @bind="newRecordType" @bind:after="OnRecordTypeChanged">
                                <option value="File">📄 Single Case (File)</option>
                                <option value="Folder">📂 New Folder (Multiple Cases)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Title *</label>
                            <input class="form-control" @bind="newRecordTitle" placeholder="e.g., Blood Test Results" />
                            @if (newRecordType == "Folder")
                            {
                                <small class="text-muted">This will be used as the folder name</small>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Details</label>
                            <textarea class="form-control" @bind="newRecordDetails" placeholder="Details..." rows="3"></textarea>
                        </div>

                        @if ((newRecordType == "File" || newRecordType == "Folder") && availableFolders.Count > 0)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold">@(newRecordType == "Folder" ? "Create Inside Folder?" : "Add to Existing Folder?")</label>
                                <select class="form-control" @bind="newRecordParentIdString">
                                    <option value="">-- @(newRecordType == "Folder" ? "Create at Root Level" : "New Separate Case") --</option>
                                    @foreach (var folder in availableFolders)
                                    {
                                        <option value="@folder.RecordID">
                                            📂 @(!string.IsNullOrEmpty(folder.FolderName) ? folder.FolderName : folder.Title)
                                        </option>
                                    }
                                </select>
                                <small class="text-muted">
                                    @if (newRecordType == "Folder")
                                    {
                                        <text>You can nest folders inside other folders</text>
                                    }
                                    else
                                    {
                                        <text>Select a folder to add this case to an existing folder, or leave as separate case</text>
                                    }
                                </small>
                            </div>
                        }

                        <button class="btn btn-primary w-100" @onclick="AddNewRecord">
                            ➕ Add @(newRecordType == "Folder" ? "Folder" : "Record")
                        </button>
                    </div>
                </div>

                <!-- Statistics -->
                <div class="card">
                    <div class="card-header">
                        <strong>📊 Statistics</strong>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-6 mb-3">
                                <h4 class="text-primary">@allRecords.Count</h4>
                                <small class="text-muted">Total Records</small>
                            </div>
                            <div class="col-6 mb-3">
                                <h4 class="text-warning">@allRecords.Count(r => r.RecordType == "Folder")</h4>
                                <small class="text-muted">Folders</small>
                            </div>
                            <div class="col-6">
                                <h4 class="text-info">@allRecords.Count(r => r.RecordType == "File")</h4>
                                <small class="text-muted">Files</small>
                            </div>
                            <div class="col-6">
                                <h4 class="text-success">@filteredRecords.Count</h4>
                                <small class="text-muted">Displayed</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Please select a patient to view and manage their medical records.
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show mt-3" role="alert">
        @statusMessage
        <button type="button" class="btn-close" @onclick='() => statusMessage = ""'></button>
    </div>
}

@code {
    // Patient search and selection
    private List<User> allPatients = new List<User>();
    private List<User> filteredPatients = new List<User>();
    private string patientSearchQuery = "";
    private int selectedPatientId = 0;
    private User? currentPatient = null;
    private bool showPatientList = false;
    private bool showAllPatientsMode = false;

    // Records data
    private List<RecordModel> allRecords = new List<RecordModel>();
    private List<RecordModel> filteredRecords = new List<RecordModel>();
    private List<RecordModel> availableFolders = new List<RecordModel>();
    private string recordSearchQuery = "";
    private DateTime? selectedDate = null;
    private int selectedRecordId = 0;

    // Status
    private string statusMessage = "";
    private bool isError = false;

    // Expanded folders tracking
    private HashSet<int> expandedFolders = new HashSet<int>();

    // Form fields for adding new records
    private string newRecordTitle = "";
    private string newRecordDetails = "";
    private string newRecordType = "File";
    private string newFolderName = "";
    private int? newRecordParentId = null;
    private string newRecordParentIdString = "";

    // Editing
    private int editingRecordId = 0;
    private string editingTitle = "";
    private string editingDetails = "";
    private string editingFolderIdString = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadPatients();
    }

    private async Task LoadPatients()
    {
        allPatients = await ApiService.GetUsersByRoleAsync("Patient");
        filteredPatients = allPatients.OrderBy(p => p.Name).ToList();
    }

    private void FilterPatients()
    {
        if (string.IsNullOrWhiteSpace(patientSearchQuery))
        {
            filteredPatients = allPatients.OrderBy(p => p.Name).ToList();
        }
        else
        {
            var query = patientSearchQuery.ToLower();
            filteredPatients = allPatients
                .Where(p => p.Name.ToLower().Contains(query) || 
                           p.UserID.ToString().Contains(query))
                .OrderBy(p => p.Name)
                .ToList();
        }
    }

    private void ClearPatientSearch()
    {
        patientSearchQuery = "";
        showPatientList = false;
        showAllPatientsMode = false;
        FilterPatients();
    }

    private void ShowAllPatients()
    {
        patientSearchQuery = "";
        filteredPatients = allPatients.OrderBy(p => p.Name).ToList();
        showPatientList = true;
        showAllPatientsMode = true;
    }

    private async Task SelectPatient(User patient)
    {
        selectedPatientId = patient.UserID;
        currentPatient = patient;
        patientSearchQuery = patient.Name;
        showPatientList = false;
        showAllPatientsMode = false;
        await LoadRecords();
    }

    private async Task OnPatientSelected()
    {
        if (selectedPatientId == 0)
        {
            currentPatient = null;
            allRecords.Clear();
            filteredRecords.Clear();
            return;
        }

        currentPatient = allPatients.FirstOrDefault(p => p.UserID == selectedPatientId);
        await LoadRecords();
    }

    private async Task LoadRecords()
    {
        if (selectedPatientId == 0) return;

        allRecords = await ApiService.GetRecordsByPatientAsync(selectedPatientId);
        
        Console.WriteLine($"[UI] LoadRecords - Loaded {allRecords.Count} records for patient {selectedPatientId}");
        foreach (var rec in allRecords.Take(3))
        {
            Console.WriteLine($"  - RecordID: {rec.RecordID}, Title: {rec.Title}, InFolder: {rec.InFolder}, FolderName: {rec.FolderName}");
        }
        
        // Load available folders for selection
        availableFolders = allRecords
            .Where(r => r.RecordType == "Folder")
            .OrderByDescending(r => r.CreatedAt)
            .ToList();
        
        Console.WriteLine($"[UI] Available folders: {availableFolders.Count}");
        
        // Apply filtering to update the displayed list
        FilterRecords();
        
        // Force UI update
        await InvokeAsync(StateHasChanged);
    }

    private void FilterRecords()
    {
        if (string.IsNullOrWhiteSpace(recordSearchQuery))
        {
            filteredRecords = allRecords.OrderByDescending(r => r.CreatedAt).ToList();
        }
        else
        {
            var query = recordSearchQuery.ToLower();
            filteredRecords = allRecords
                .Where(r => r.Title.ToLower().Contains(query) || 
                           (r.Details != null && r.Details.ToLower().Contains(query)))
                .OrderByDescending(r => r.CreatedAt)
                .ToList();
        }

        // Apply date filter if one is selected
        if (selectedDate.HasValue)
        {
            filteredRecords = filteredRecords
                .Where(r => r.CreatedAt.Date == selectedDate.Value.Date)
                .ToList();
        }
    }

    private void FilterByDate(DateTime date)
    {
        selectedDate = date;
        FilterRecords();
    }

    private void ShowAllRecords()
    {
        selectedDate = null;
        recordSearchQuery = "";
        selectedRecordId = 0;
        FilterRecords();
    }

    private List<DateTime> GetUniqueDates()
    {
        return allRecords
            .Select(r => r.CreatedAt.Date)
            .Distinct()
            .OrderByDescending(d => d)
            .ToList();
    }

    private int GetRecordCountByDate(DateTime date)
    {
        return allRecords.Count(r => r.CreatedAt.Date == date.Date);
    }

    private void HandleRecordClick(RecordModel record)
    {
        // If it's a folder, toggle expand/collapse
        if (record.RecordType == "Folder")
        {
            ToggleFolder(record.RecordID);
        }
        else
        {
            // For files, just select them
            selectedRecordId = record.RecordID;
        }
    }

    private void ToggleFolder(int folderId)
    {
        if (expandedFolders.Contains(folderId))
        {
            expandedFolders.Remove(folderId);
        }
        else
        {
            expandedFolders.Add(folderId);
        }
    }

    private void OnRecordTypeChanged()
    {
        // Clear folder name when switching away from folder type
        if (newRecordType != "Folder")
        {
            newFolderName = "";
        }
    }

    private async Task AddNewRecord()
    {
        if (string.IsNullOrWhiteSpace(newRecordTitle))
        {
            statusMessage = "❌ Please enter a title.";
            isError = true;
            return;
        }

        if (selectedPatientId == 0)
        {
            statusMessage = "❌ Please select a patient first.";
            isError = true;
            return;
        }

        try
        {
            // Parse the folder ID from string
            int? parentFolderId = null;
            if (!string.IsNullOrWhiteSpace(newRecordParentIdString) && int.TryParse(newRecordParentIdString, out int parsedId))
            {
                parentFolderId = parsedId;
            }

            var newRecord = new RecordModel
            {
                PatientID = selectedPatientId,
                InFolder = parentFolderId,
                RecordType = newRecordType,
                Title = newRecordTitle,
                Details = newRecordDetails,
                FolderName = newRecordType == "Folder" ? newRecordTitle : "" // Use title as folder name
            };

            Console.WriteLine($"DEBUG: Saving record - PatientID: {newRecord.PatientID}, Title: {newRecord.Title}, Type: {newRecord.RecordType}, InFolder: {newRecord.InFolder}");
            
            await ApiService.SaveRecordAsync(newRecord);
            
            Console.WriteLine($"DEBUG: Record saved with ID: {newRecord.RecordID}");
            
            if (newRecordType == "Folder")
            {
                statusMessage = $"✅ Created new folder: '{newRecordTitle}' (ID: {newRecord.RecordID})";
            }
            else if (newRecordParentId.HasValue)
            {
                var parentFolder = availableFolders.FirstOrDefault(f => f.RecordID == newRecordParentId.Value);
                statusMessage = $"✅ Added '{newRecordTitle}' to folder '{parentFolder?.FolderName}' (ID: {newRecord.RecordID})";
            }
            else
            {
                statusMessage = $"✅ Added new separate case: '{newRecordTitle}' (ID: {newRecord.RecordID})";
            }
            
            isError = false;
            
            // Clear form
            newRecordTitle = "";
            newRecordDetails = "";
            newFolderName = "";
            newRecordParentId = null;
            newRecordParentIdString = "";
            newRecordType = "File";
            
            // Clear filters to show the new record
            selectedDate = null;
            recordSearchQuery = "";
            
            // Reload records
            await LoadRecords();
            
            // Force UI refresh
            StateHasChanged();
        }
        catch (Exception ex)
        {
            statusMessage = $"❌ Error adding record: {ex.Message}";
            isError = true;
        }
    }

    private void StartEdit(RecordModel record)
    {
        editingRecordId = record.RecordID;
        editingTitle = record.Title;
        editingDetails = record.Details ?? "";
        editingFolderIdString = record.InFolder.HasValue ? record.InFolder.Value.ToString() : "";
        Console.WriteLine($"[UI] StartEdit - RecordID: {record.RecordID}, InFolder: {record.InFolder}, editingFolderIdString: '{editingFolderIdString}'");
    }

    private async Task SaveEdit()
    {
        if (string.IsNullOrWhiteSpace(editingTitle))
        {
            statusMessage = "❌ Title cannot be empty.";
            isError = true;
            return;
        }

        try
        {
            var record = allRecords.FirstOrDefault(r => r.RecordID == editingRecordId);
            if (record != null)
            {
                Console.WriteLine($"[UI] Before update - RecordID: {record.RecordID}, Title: {record.Title}, Details: {record.Details}, InFolder: {record.InFolder}");
                record.Title = editingTitle;
                record.Details = editingDetails;
                
                // Parse and update folder location
                if (!string.IsNullOrWhiteSpace(editingFolderIdString) && int.TryParse(editingFolderIdString, out int folderId))
                {
                    record.InFolder = folderId;
                }
                else
                {
                    record.InFolder = null;
                }
                
                Console.WriteLine($"[UI] After local update - RecordID: {record.RecordID}, Title: {record.Title}, Details: {record.Details}, InFolder: {record.InFolder}");
                
                var result = await ApiService.UpdateRecordAsync(record);
                Console.WriteLine($"[UI] API Update result: {result}");
                
                if (result)
                {
                    statusMessage = $"✅ Record updated successfully.";
                    isError = false;
                    editingRecordId = 0;
                    
                    // Reload to reflect changes
                    await LoadRecords();
                }
                else
                {
                    statusMessage = $"❌ Failed to update record on server";
                    isError = true;
                }
            }
            else
            {
                Console.WriteLine($"[UI] ERROR: Could not find record with ID {editingRecordId}");
                statusMessage = $"❌ Could not find record to update";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"❌ Error updating record: {ex.Message}";
            isError = true;
        }
    }

    private void CancelEdit()
    {
        editingRecordId = 0;
        editingTitle = "";
        editingDetails = "";
    }

    private async Task DeleteRecord(int recordId)
    {
        if (!confirm($"Are you sure you want to delete this record?"))
            return;

        try
        {
            await ApiService.DeleteRecordAsync(recordId);
            statusMessage = "✅ Record deleted successfully.";
            isError = false;
            
            // Reload records
            await LoadRecords();
        }
        catch (Exception ex)
        {
            statusMessage = $"❌ Error deleting record: {ex.Message}";
            isError = true;
        }
    }

    private bool confirm(string message)
    {
        // This is a placeholder - in production, use JSInterop for confirm dialog
        return true;
    }

    private int GetChildCount(int folderId)
    {
        // Count all records (files and folders) inside this folder
        return allRecords.Count(r => r.InFolder == folderId);
    }

    private List<RecordModel> GetEditableParentFolders(int currentRecordId)
    {
        // When editing, prevent circular references
        var currentRecord = allRecords.FirstOrDefault(r => r.RecordID == currentRecordId);
        
        if (currentRecord == null || currentRecord.RecordType != "Folder")
        {
            // If it's a file, can go into any folder except itself (which isn't a folder anyway)
            return availableFolders.Where(f => f.RecordID != currentRecordId).ToList();
        }
        
        // For folders, prevent circular references:
        // 1. Can't put folder inside itself
        // 2. Can't put folder inside its own descendants
        var descendantIds = GetAllDescendants(currentRecordId);
        descendantIds.Add(currentRecordId); // Add self to exclusion list
        
        return availableFolders.Where(f => !descendantIds.Contains(f.RecordID)).ToList();
    }

    private HashSet<int> GetAllDescendants(int folderId)
    {
        var descendants = new HashSet<int>();
        var directChildren = allRecords.Where(r => r.InFolder == folderId).ToList();
        
        foreach (var child in directChildren)
        {
            descendants.Add(child.RecordID);
            
            // If this child is also a folder, get its descendants recursively
            if (child.RecordType == "Folder")
            {
                var childDescendants = GetAllDescendants(child.RecordID);
                foreach (var desc in childDescendants)
                {
                    descendants.Add(desc);
                }
            }
        }
        
        return descendants;
    }
}