@page "/login"
@rendermode InteractiveServer
@using HealthTech.Services
@inject UserSession Session
@inject NavigationManager Nav
@inject ApiService ApiService

<PageTitle>Login</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header bg-primary text-white text-center">
                    <h3>MedEase Login</h3>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(message))
                    {
                        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
                            @message
                            <button type="button" class="btn-close" @onclick="() => message = string.Empty"></button>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Email Address</label>
                        <input type="email" class="form-control" @bind="email" 
                               placeholder="Enter your email" 
                               @onkeypress="HandleKeyPress" />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input type="password" class="form-control" @bind="password" 
                               placeholder="Enter your password"
                               @onkeypress="HandleKeyPress" />
                    </div>
                    
                    <div class="d-grid gap-2">
                        <button class="btn btn-primary btn-lg" @onclick="DoLogin" disabled="@isProcessing">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Logging in...</span>
                            }
                            else
                            {
                                <span>Login</span>
                            }
                        </button>
                        
                        <button class="btn btn-outline-success" @onclick="GoToRegister">
                            Don't have an account? Register
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string message = "";
    private bool isSuccess = false;
    private bool isProcessing = false;

    private async Task DoLogin()
    {
        message = "";
        isSuccess = false;
        
        if (string.IsNullOrWhiteSpace(email))
        {
            message = "Email is required";
            return;
        }
        
        if (string.IsNullOrWhiteSpace(password))
        {
            message = "Password is required";
            return;
        }
        
        isProcessing = true;
        
        try
        {
            var response = await ApiService.LoginAsync(email, password);
            
            if (response.Success && response.User != null)
            {
                Session.Login(response.User);
                message = "Login successful! Redirecting...";
                isSuccess = true;
                
                // Wait a moment then redirect
                await Task.Delay(500);
                Nav.NavigateTo("/");
            }
            else
            {
                message = response.Message;
                isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("API Connection") || ex.Message.Contains("API Timeout"))
            {
                message = "⚠️ Cannot connect to server. Please make sure HealthTech.API is running!";
            }
            else
            {
                message = "Error: " + ex.Message;
            }
            isSuccess = false;
        }
        finally
        {
            isProcessing = false;
        }
    }
    
    private void GoToRegister()
    {
        Nav.NavigateTo("/register");
    }
    
    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isProcessing)
        {
            await DoLogin();
        }
    }
}
