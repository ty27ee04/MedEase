@code {
    // ===== AUTHORIZATION =====
    private bool isAuthorized = false;
    private int currentDoctorId = 0;

    protected override async Task OnInitializedAsync()
    {
        // Check if user is logged in and has Doctor role
        if (!Session.IsLoggedIn || !Session.IsInRole("Doctor"))
        {
            isAuthorized = false;
            // Redirect to home page after a short delay
            _ = Task.Run(async () =>
            {
                await Task.Delay(2000);
                Nav.NavigateTo("/", true);
            });
        }
        else
        {
            isAuthorized = true;
            currentDoctorId = Session.CurrentUser?.UserID ?? 0;
            await LoadWorkingSchedule();
        }
    }
    
    // ===== WORKING SCHEDULE MANAGEMENT =====
    private bool IsWorkingScheduleModalOpen = false;
    private string scheduleMode = "schedule"; // "schedule" or "leave"
    private string ScheduleModalMessage = "";
    private string ScheduleMessage = "";
    
    private readonly List<string> WeekDays = new()
    {
        "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"
    };
    
    private Dictionary<string, DaySchedule> weeklySchedule = new();
    private List<DateTime> leaveDates = new();
    private DateTime leaveStartDate = DateTime.Today;
    private DateTime leaveEndDate = DateTime.Today.AddDays(7);
    
    private async Task LoadWorkingSchedule()
    {
        try
        {
            // Initialize weekly schedule
            foreach (var day in WeekDays)
            {
                weeklySchedule[day] = new DaySchedule 
                { 
                    Day = day,
                    StartTime = "09:00",
                    EndTime = "17:00",
                    IsWorking = false
                };
            }
            
            // Load existing schedule from database
            var workingTimes = await ApiService.GetDoctorWorkingTimesAsync(currentDoctorId);
            
            // Populate weekly schedule (type = 'working' and no specific date)
            foreach (var wt in workingTimes.Where(w => w.Type == "working" && !w.Date.HasValue))
            {
                if (weeklySchedule.ContainsKey(wt.Day))
                {
                    weeklySchedule[wt.Day].IsWorking = true;
                    if (wt.StartTime.HasValue)
                        weeklySchedule[wt.Day].StartTime = wt.StartTime.Value.ToString(@"hh\:mm");
                    if (wt.EndTime.HasValue)
                        weeklySchedule[wt.Day].EndTime = wt.EndTime.Value.ToString(@"hh\:mm");
                }
            }
            
            // Populate leave dates (type = 'on leave')
            leaveDates = workingTimes
                .Where(w => w.Type == "on leave" && w.Date.HasValue)
                .Select(w => w.Date!.Value)
                .ToList();
        }
        catch (Exception ex)
        {
            ScheduleMessage = $"Error loading schedule: {ex.Message}";
        }
    }
    
    private async Task OpenWorkingScheduleModal()
    {
        await LoadWorkingSchedule();
        IsWorkingScheduleModalOpen = true;
        ScheduleModalMessage = "";
    }
    
    private void CloseWorkingScheduleModal()
    {
        IsWorkingScheduleModalOpen = false;
        ScheduleModalMessage = "";
    }
    
    private void OnScheduleModeChanged()
    {
        ScheduleModalMessage = "";
    }
    
    private void AddLeaveDateRange()
    {
        if (leaveEndDate < leaveStartDate)
        {
            ScheduleModalMessage = "End date must be after start date";
            return;
        }
        
        var daysAdded = 0;
        var currentDate = leaveStartDate.Date;
        
        while (currentDate <= leaveEndDate.Date)
        {
            if (!leaveDates.Contains(currentDate))
            {
                leaveDates.Add(currentDate);
                daysAdded++;
            }
            currentDate = currentDate.AddDays(1);
        }
        
        if (daysAdded > 0)
        {
            ScheduleModalMessage = $"Added {daysAdded} leave day(s) from {leaveStartDate:yyyy-MM-dd} to {leaveEndDate:yyyy-MM-dd}";
        }
        else
        {
            ScheduleModalMessage = "All dates in this range are already in the leave list";
        }
    }
    
    private void RemoveLeaveDate(DateTime date)
    {
        leaveDates.Remove(date);
        ScheduleModalMessage = $"Removed {date:yyyy-MM-dd} from leave dates";
    }
    
    private async Task SaveWorkingSchedule()
    {
        try
        {
            if (scheduleMode == "schedule")
            {
                // Save weekly working schedule
                var workingTimes = new List<WorkingTime>();
                
                foreach (var kvp in weeklySchedule)
                {
                    if (kvp.Value.IsWorking)
                    {
                        workingTimes.Add(new WorkingTime
                        {
                            DoctorID = currentDoctorId,
                            Day = kvp.Key,
                            StartTime = TimeSpan.Parse(kvp.Value.StartTime),
                            EndTime = TimeSpan.Parse(kvp.Value.EndTime),
                            Type = "working",
                            Date = null // Weekly recurring schedule
                        });
                    }
                }
                
                var success = await ApiService.SaveScheduleAsync(currentDoctorId, workingTimes);
                
                if (success)
                {
                    ScheduleModalMessage = "✓ Weekly schedule saved successfully!";
                    ScheduleMessage = "Schedule updated successfully";
                }
                else
                {
                    ScheduleModalMessage = "❌ Failed to save schedule";
                }
            }
            else
            {
                // Save leave dates
                var success = await ApiService.SaveLeavesAsync(currentDoctorId, leaveDates);
                
                if (success)
                {
                    ScheduleModalMessage = "✓ Leave dates saved successfully!";
                    ScheduleMessage = "Leave dates updated successfully";
                }
                else
                {
                    ScheduleModalMessage = "❌ Failed to save leave dates";
                }
            }
        }
        catch (Exception ex)
        {
            ScheduleModalMessage = $"❌ Error: {ex.Message}";
        }
    }
    
    private class DaySchedule
    {
        public string Day { get; set; } = "";
        public bool IsWorking { get; set; }
        public string StartTime { get; set; } = "09:00";
        public string EndTime { get; set; } = "17:00";
    }
    
    // ===== MOCK DATA AND EXISTING FUNCTIONALITY =====
    //  (1) Working settings (mock - kept for KPI display)
    private TimeOnly WorkingStart = new(9, 0);
    private TimeOnly WorkingEnd = new(17, 0);
    private string DayOff = "Sunday";
