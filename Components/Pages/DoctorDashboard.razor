@page "/doctor"
@using HealthTech.Services
@inject NavigationManager Nav
@inject UserSession Session
@inject ApiService ApiService
@rendermode InteractiveServer

@if (!isAuthorized)
{
    <div class="alert alert-danger m-4">
        <h4>Access Denied</h4>
        <p>You must be logged in as a Doctor to access this page.</p>
        <p>Redirecting to home page...</p>
    </div>
}
else
{
<div class="dashboard-wrap">
    <h3 class="page-title">Doctor Dashboard</h3>
    <p class="page-subtitle">Working schedule + today's appointments + quick access to patient records</p>

    <!-- Working Settings - Button to open modal -->
    <div class="panel">
        <div class="panel-title">Working Schedule Management</div>
        <p class="hint mb-3">Configure your weekly working hours and manage leave days</p>
        
        <div class="actions-row">
            <button class="btn" @onclick="OpenWorkingScheduleModal">Set Working Schedule</button>
            <div class="saved-hint">@ScheduleMessage</div>
        </div>
    </div>

    <!-- KPI -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-header">
                <span class="kpi-label">Today's Appointments</span>
                <span class="kpi-badge badge-blue">Today</span>
            </div>
            <div class="kpi-value">@TodayAppointments</div>
            <div class="kpi-hint">Total scheduled consultations.</div>
        </div>

        <div class="kpi-card">
            <div class="kpi-header">
                <span class="kpi-label">Completed</span>
                <span class="kpi-badge badge-green">Done</span>
            </div>
            <div class="kpi-value">@CompletedConsultations</div>
            <div class="kpi-hint">Patients already served today.</div>
        </div>

        <div class="kpi-card">
            <div class="kpi-header">
                <span class="kpi-label">Pending Reviews</span>
                <span class="kpi-badge badge-orange">Pending</span>
            </div>
            <div class="kpi-value">@PendingLabReports</div>
            <div class="kpi-hint">Reports / lab results waiting review.</div>
        </div>

        <div class="kpi-card">
            <div class="kpi-header">
                <span class="kpi-label">Doctor Status</span>
                <span class="kpi-badge badge-purple">@DoctorStatusBadge</span>
            </div>
            <div class="kpi-value">@DoctorStatusValue</div>
            <div class="kpi-hint">@DoctorStatusHint</div>
        </div>
    </div>

    <!-- (2) Today schedule + edit appointment date/time -->
    <div class="panel">
        <div class="panel-title">Today Patient Schedule</div>

        @if (TodaySchedule == null || TodaySchedule.Count == 0)
        {
            <div class="empty">No appointments for today.</div>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th style="width:120px;">Time</th>
                        <th>Patient</th>
                        <th>Reason</th>
                        <th style="width:140px;">Status</th>
                        <th style="width:260px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in TodaySchedule)
                    {
                        var isEditing = (EditingPatientId == a.PatientId);

                        <tr>
                            <td>
                                @if (!isEditing)
                                {
                                    @a.AppointmentDateTime.ToString("HH:mm")
                                }
                                else
                                {
                                    <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                                        <input class="input" type="date" @bind="InlineEditDate" />
                                        <input class="input" type="time" @bind="InlineEditTime" />
                                    </div>
                                }
                            </td>

                            <td>
                                <span style="font-weight:700;">@a.PatientName</span>
                                <span class="muted">(ID: @a.PatientId)</span>
                            </td>

                            <td>@a.Reason</td>

                            <td>
                                <span class="status @GetStatusClass(a.Status)">@a.Status</span>
                            </td>

                            <td class="actions-cell">
                                @if (!isEditing)
                                {
                                    <button class="btn-sm" @onclick="() => StartInlineEdit(a)">Edit Date/Time</button>

                                    <button class="btn-sm btn-sm-outline"
                                            @onclick="() => GoPatientRecords(a.PatientId)">
                                        Patient Records / Add Diagnosis
                                    </button>
                                }
                                else
                                {
                                    <button class="btn-sm" @onclick="SaveInlineEdit">Save</button>
                                    <button class="btn-sm btn-sm-outline" @onclick="CancelInlineEdit">Cancel</button>

                                    <div class="tiny-note" style="margin-top:6px;">
                                        @InlineEditMessage
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

            <div class="tiny-note">
                Tip: Edit appointment date/time uses mock update now. Later replace with DB update.
            </div>
        }
    </div>

    

</div>

@* Working Schedule Modal *@
@if (IsWorkingScheduleModalOpen)
{
    <div class="modal-backdrop" @onclick="CloseWorkingScheduleModal">
        <div class="modal-large" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h4 class="modal-title">
                    @if (scheduleMode == "schedule")
                    {
                        <text>Set Weekly Working Schedule</text>
                    }
                    else
                    {
                        <text>Manage Leave Days</text>
                    }
                </h4>
                <div class="mode-switcher">
                    <select class="input" @bind="scheduleMode" @bind:after="OnScheduleModeChanged">
                        <option value="schedule">Working Schedule</option>
                        <option value="leave">Leave Days</option>
                    </select>
                </div>
            </div>

            <div class="modal-body">
                @if (scheduleMode == "schedule")
                {
                    <p class="hint mb-3">Set your working hours for each day of the week. Leave unchecked for days off.</p>
                    
                    <div class="schedule-grid">
                        @foreach (var day in WeekDays)
                        {
                            var daySchedule = weeklySchedule[day];
                            <div class="schedule-day-card">
                                <div class="day-header">
                                    <input type="checkbox" @bind="daySchedule.IsWorking" />
                                    <strong>@day</strong>
                                </div>
                                
                                @if (daySchedule.IsWorking)
                                {
                                    <div class="time-inputs">
                                        <div class="field">
                                            <label class="label-sm">Start Time</label>
                                            <input class="input-sm" type="time" value="@daySchedule.StartTime" 
                                                   @onchange="@(e => daySchedule.StartTime = e.Value?.ToString() ?? "09:00")" />
                                        </div>
                                        <div class="field">
                                            <label class="label-sm">End Time</label>
                                            <input class="input-sm" type="time" value="@daySchedule.EndTime" 
                                                   @onchange="@(e => daySchedule.EndTime = e.Value?.ToString() ?? "17:00")" />
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="day-off-label">Day Off</div>
                                }
                            </div>
                        }
                    </div>

                    <div class="modal-message">@ScheduleModalMessage</div>
                }
                else
                {
                    <p class="hint mb-3">Select a date range for your leave. All dates in the range will be saved.</p>
                    
                    <div class="leave-section">
                        <div class="field">
                            <label class="label">Leave Start Date</label>
                            <input class="input" type="date" @bind="leaveStartDate" />
                        </div>
                        <div class="field">
                            <label class="label">Leave End Date</label>
                            <input class="input" type="date" @bind="leaveEndDate" />
                        </div>
                        <button class="btn-sm" @onclick="AddLeaveDateRange">Add Leave Period</button>
                    </div>

                    <div class="leave-list">
                        <h5>Current Leave Days:</h5>
                        @if (leaveDates.Any())
                        {
                            <div class="leave-dates">
                                @foreach (var date in leaveDates.OrderBy(d => d))
                                {
                                    <div class="leave-date-item">
                                        <span>@date.ToString("dddd, MMMM dd, yyyy")</span>
                                        <button class="btn-sm-outline" @onclick="() => RemoveLeaveDate(date)">Remove</button>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="empty">No leave days scheduled</p>
                        }
                    </div>

                    <div class="modal-message">@ScheduleModalMessage</div>
                }
            </div>

            <div class="modal-actions">
                <button class="btn-sm-outline" @onclick="CloseWorkingScheduleModal">Cancel</button>
                <button class="btn-sm" @onclick="SaveWorkingSchedule">Save</button>
            </div>
        </div>
    </div>
}
}

