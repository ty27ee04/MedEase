    private string GetStatusClass(string? status)
    {
        status ??= "Scheduled";
        return status.Trim().ToLowerInvariant() switch
        {
            "scheduled" => "scheduled",
            "checked-in" => "checked-in",
            "checked in" => "checked-in",
            "waiting" => "waiting",
            "done" => "done",
            _ => "scheduled"
        };
    }

    // ====== (2) Edit appointment modal ======
    private bool IsEditModalOpen = false;
    private AppointmentRow? EditingAppointment;
    private DateTime EditDate = DateTime.Today;
    private TimeOnly EditTime = new(9, 0);
    private string ModalMessage = "";

    private void OpenEditModal(AppointmentRow a)
    {
        EditingAppointment = a;
        EditDate = a.AppointmentDateTime.Date;
        EditTime = TimeOnly.FromDateTime(a.AppointmentDateTime);
        ModalMessage = "";
        IsEditModalOpen = true;
    }

    private void CloseEditModal()
    {
        IsEditModalOpen = false;
        EditingAppointment = null;
        ModalMessage = "";
    }

    private void SaveEditAppointment()
    {
        if (EditingAppointment == null) return;

        // Combine date + time safely
        var newDt = EditDate.Date.Add(EditTime.ToTimeSpan());
        EditingAppointment.AppointmentDateTime = newDt;

        ModalMessage = $"Updated appointment to {newDt:yyyy-MM-dd HH:mm} (mock).";
        // keep modal open so user can see message; user can close manually
    }

    // ====== (3) Link to patient records / add diagnosis ======
    private void GoPatientRecords(string patientId)
    {
        Nav.NavigateTo($"/patient-records?patientId={Uri.EscapeDataString(patientId)}");
    }

    private class AppointmentRow
    {
        public AppointmentRow(string patientId, string patientName, DateTime dt, string reason, string status)
        {
            PatientId = patientId;
            PatientName = patientName;
            AppointmentDateTime = dt;
            Reason = reason;
            Status = status;
        }

        public string PatientId { get; set; }
        public string PatientName { get; set; }
        public DateTime AppointmentDateTime { get; set; }
        public string Reason { get; set; }
        public string Status { get; set; }
    }

    // ===== Inline Edit (Method A) =====
    private string? EditingPatientId = null;       
    private AppointmentRow? EditingRow = null;     

    private DateTime InlineEditDate = DateTime.Today;
    private TimeOnly InlineEditTime = new(9, 0);
    private string InlineEditMessage = "";

    private void StartInlineEdit(AppointmentRow a)
    {
        EditingPatientId = a.PatientId;
        EditingRow = a;

        InlineEditDate = a.AppointmentDateTime.Date;
        InlineEditTime = TimeOnly.FromDateTime(a.AppointmentDateTime);

        InlineEditMessage = "";
    }

    private void CancelInlineEdit()
    {
        EditingPatientId = null;
        EditingRow = null;
        InlineEditMessage = "";
    }

    private async Task SaveInlineEdit()
    {
        if (EditingRow == null) return;

        var newDt = InlineEditDate.Date.Add(InlineEditTime.ToTimeSpan());
        EditingRow.AppointmentDateTime = newDt;

        InlineEditMessage = $"Updated to {newDt:yyyy-MM-dd HH:mm} (mock).";

        await Task.Delay(800);

        EditingPatientId = null;
        EditingRow = null;
        InlineEditMessage = "";
    }

}
