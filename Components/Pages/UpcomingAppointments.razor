@page "/upcoming-appointments"
@rendermode InteractiveServer
@inject NotificationService NotificationService
@using HealthTech.Services

<PageTitle>Appointments Management</PageTitle>

<h1>Appointments Management</h1>
<p class="text-muted">Manage and track appointments with filters and search</p>

@if (isProcessing)
{
    <div class="alert alert-info">
        <span class="spinner-border spinner-border-sm me-2"></span>
        Processing...
    </div>
}

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show">
        @message
        <button type="button" class="btn-close" @onclick="() => message = string.Empty"></button>
    </div>
}

@if (isEditing)
{
    <div class="card p-4 mb-4 border-primary shadow-sm">
        <h4>Edit Appointment #@editingModel.AppointmentID</h4>
        
        <div class="row">
            <div class="col-md-6 mb-3">
                <label><strong>Patient:</strong></label>
                <input class="form-control" value="@editingModel.PatientName" disabled />
            </div>

            <div class="col-md-6 mb-3">
                <label><strong>Doctor:</strong></label>
                <input class="form-control" value="@editingModel.DoctorName" disabled />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label><strong>Date & Time:</strong></label>
                <input type="datetime-local" class="form-control" @bind="editingDateTime" />
            </div>

            <div class="col-md-6 mb-3">
                <label><strong>Status:</strong></label>
                <select class="form-control" @bind="editingModel.Status">
                    <option value="Confirmed">Confirmed</option>
                    <option value="Pending">Pending</option>
                    <option value="Cancelled">Cancelled</option>
                    <option value="Completed">Completed</option>
                    <option value="ReminderSent">Reminder Sent</option>
                    <option value="CheckedIn">Checked In</option>
                </select>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-success" @onclick="SaveEdit">
                <i class="bi bi-check-circle"></i> Save Changes
            </button>
            <button class="btn btn-secondary" @onclick="CancelEdit">
                <i class="bi bi-x-circle"></i> Cancel
            </button>
        </div>
    </div>
}

<!-- Filters Section -->
<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-3">
            <!-- Time Filter -->
            <div class="col-md-3">
                <label class="form-label fw-bold">Time Filter</label>
                <select class="form-select" @bind="timeFilter" @bind:after="ApplyFilters">
                    <option value="Upcoming">Upcoming</option>
                    <option value="Past">Past</option>
                    <option value="All">All</option>
                </select>
            </div>

            <!-- Date Range (only for All) -->
            @if (timeFilter == "All")
            {
                <div class="col-md-3">
                    <label class="form-label fw-bold">From Date</label>
                    <input type="date" class="form-control" @bind="filterFromDate" @bind:after="ApplyFilters" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">To Date</label>
                    <input type="date" class="form-control" @bind="filterToDate" @bind:after="ApplyFilters" />
                </div>
            }

            <!-- Search -->
            <div class="col-md-3">
                <label class="form-label fw-bold">Search</label>
                <input type="text" class="form-control" placeholder="Patient, Doctor, ID..." 
                       @bind="searchText" @bind:after="ApplyFilters" />
            </div>

            <!-- Status Filter -->
            <div class="col-md-3">
                <label class="form-label fw-bold">Status</label>
                <select class="form-select" @bind="statusFilter" @bind:after="ApplyFilters">
                    <option value="">All Status</option>
                    <option value="Pending">Pending</option>
                    <option value="Confirmed">Confirmed</option>
                    <option value="ReminderSent">Reminder Sent</option>
                    <option value="CheckedIn">Checked In</option>
                    <option value="Completed">Completed</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
            </div>

            <!-- Type Filter -->
            <div class="col-md-3">
                <label class="form-label fw-bold">Type</label>
                <select class="form-select" @bind="typeFilter" @bind:after="ApplyFilters">
                    <option value="">All Types</option>
                    <option value="Online">Online</option>
                    <option value="Physical">Physical</option>
                </select>
            </div>

            <!-- Sort By -->
            <div class="col-md-3">
                <label class="form-label fw-bold">Sort By</label>
                <select class="form-select" @bind="sortBy" @bind:after="ApplyFilters">
                    <option value="DateTime">Date & Time</option>
                    <option value="Patient">Patient Name</option>
                    <option value="Doctor">Doctor Name</option>
                    <option value="ID">ID</option>
                    <option value="Status">Status</option>
                </select>
            </div>

            <!-- Sort Order -->
            <div class="col-md-3">
                <label class="form-label fw-bold">Order</label>
                <select class="form-select" @bind="sortOrder" @bind:after="ApplyFilters">
                    <option value="ASC">Ascending</option>
                    <option value="DESC">Descending</option>
                </select>
            </div>

            <!-- Reset Button -->
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-outline-secondary w-100" @onclick="ResetFilters">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset Filters
                </button>
            </div>
        </div>

        <div class="mt-2">
            <small class="text-muted">Showing @filteredAppointments.Count of @allAppointments.Count appointments</small>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        @if (filteredAppointments.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x" style="font-size: 3rem; color: #ccc;"></i>
                <p class="mt-3 text-muted">No appointments found</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Date & Time</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Time Until</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in filteredAppointments)
                        {
                            var timeUntil = appt.DateTime - DateTime.Now;
                            var hoursUntil = timeUntil.TotalHours;
                            
                            <tr>
                                <td>@appt.AppointmentID</td>
                                <td>
                                    <strong>@appt.PatientName</strong>
                                </td>
                                <td>@appt.DoctorName</td>
                                <td>
                                    <div>@appt.DateTime.ToString("dd MMM yyyy")</div>
                                    <small class="text-muted">@appt.DateTime.ToString("hh:mm tt")</small>
                                </td>
                                <td>
                                    <span class="badge @(appt.Type == "Online" ? "bg-info" : "bg-primary")">
                                        @appt.Type
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(appt.Status)">
                                        @appt.Status
                                    </span>
                                </td>
                                <td>
                                    <span class="@GetTimeUntilClass(hoursUntil)">
                                        @GetTimeUntilText(timeUntil)
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex gap-1 flex-wrap">
                                        <button class="btn btn-sm btn-outline-primary" 
                                                @onclick="() => EditAppointment(appt)">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </button>
                                        
                                        @if (appt.Status != "ReminderSent" && appt.Status != "CheckedIn" && appt.Status != "Completed" && appt.Status != "Cancelled")
                                        {
                                            <button class="btn btn-sm btn-outline-info" 
                                                    @onclick="() => ResendReminder(appt)"
                                                    disabled="@isProcessing">
                                                <i class="bi bi-bell me-1"></i>Remind
                                            </button>
                                        }

                                        @if (appt.Status == "ReminderSent")
                                        {
                                            <button class="btn btn-sm btn-outline-success" 
                                                    @onclick="() => CheckInPatient(appt)">
                                                <i class="bi bi-check2-square me-1"></i>Check In
                                            </button>
                                        }

                                        @if (appt.Status == "CheckedIn")
                                        {
                                            <button class="btn btn-sm btn-outline-dark" 
                                                    @onclick="() => CompleteAppointment(appt)">
                                                <i class="bi bi-clipboard-check me-1"></i>Complete
                                            </button>
                                        }

                                        @if (appt.Status != "Cancelled" && appt.Status != "Completed")
                                        {
                                            <button class="btn btn-sm btn-outline-warning" 
                                                    @onclick="() => CancelAppointment(appt)">
                                                <i class="bi bi-x-circle me-1"></i>Cancel
                                            </button>
                                        }
                                        
                                        <button class="btn btn-sm btn-outline-danger" 
                                                @onclick="() => DeleteAppointment(appt.AppointmentID)"
                                                @onclick:preventDefault="true"
                                                disabled="@isProcessing">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<AppointmentModel> allAppointments = new List<AppointmentModel>();
    private List<AppointmentModel> filteredAppointments = new List<AppointmentModel>();
    
    private bool isEditing = false;
    private bool isProcessing = false;
    private bool isError = false;
    private string message = "";
    
    private AppointmentModel editingModel = new AppointmentModel();
    private DateTime editingDateTime = DateTime.Now;

    // Filter variables
    private string timeFilter = "Upcoming";
    private DateTime filterFromDate = DateTime.Today;
    private DateTime filterToDate = DateTime.Today;
    private string searchText = "";
    private string statusFilter = "";
    private string typeFilter = "";
    private string sortBy = "DateTime";
    private string sortOrder = "ASC";

    protected override void OnInitialized()
    {
        LoadData();
        ApplyFilters();
    }

    private void LoadData()
    {
        allAppointments = DatabaseManager.GetInstance().GetAllAppointments();
    }

    private void ApplyFilters()
    {
        var filtered = allAppointments.AsEnumerable();

        // Time filter
        if (timeFilter == "Upcoming")
        {
            filtered = filtered.Where(a => a.DateTime >= DateTime.Now && 
                                           a.Status != "Cancelled" && 
                                           a.Status != "Completed");
        }
        else if (timeFilter == "Past")
        {
            filtered = filtered.Where(a => a.DateTime < DateTime.Now || 
                                           a.Status == "Completed");
        }
        else if (timeFilter == "All")
        {
            filtered = filtered.Where(a => a.DateTime.Date >= filterFromDate.Date && 
                                           a.DateTime.Date <= filterToDate.Date);
        }

        // Search filter
        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var search = searchText.ToLower();
            filtered = filtered.Where(a =>
                a.PatientName.ToLower().Contains(search) ||
                a.DoctorName.ToLower().Contains(search) ||
                a.AppointmentID.ToString().Contains(search) ||
                a.Type.ToLower().Contains(search) ||
                a.Status.ToLower().Contains(search)
            );
        }

        // Status filter
        if (!string.IsNullOrEmpty(statusFilter))
        {
            filtered = filtered.Where(a => a.Status == statusFilter);
        }

        // Type filter
        if (!string.IsNullOrEmpty(typeFilter))
        {
            filtered = filtered.Where(a => a.Type == typeFilter);
        }

        // Sort
        filtered = sortBy switch
        {
            "Patient" => sortOrder == "ASC" 
                ? filtered.OrderBy(a => a.PatientName) 
                : filtered.OrderByDescending(a => a.PatientName),
            "Doctor" => sortOrder == "ASC" 
                ? filtered.OrderBy(a => a.DoctorName) 
                : filtered.OrderByDescending(a => a.DoctorName),
            "ID" => sortOrder == "ASC" 
                ? filtered.OrderBy(a => a.AppointmentID) 
                : filtered.OrderByDescending(a => a.AppointmentID),
            "Status" => sortOrder == "ASC" 
                ? filtered.OrderBy(a => a.Status) 
                : filtered.OrderByDescending(a => a.Status),
            _ => sortOrder == "ASC" 
                ? filtered.OrderBy(a => a.DateTime) 
                : filtered.OrderByDescending(a => a.DateTime)
        };

        filteredAppointments = filtered.ToList();
        StateHasChanged();
    }

    private void ResetFilters()
    {
        timeFilter = "Upcoming";
        filterFromDate = DateTime.Today;
        filterToDate = DateTime.Today;
        searchText = "";
        statusFilter = "";
        typeFilter = "";
        sortBy = "DateTime";
        sortOrder = "ASC";
        ApplyFilters();
    }

    private void EditAppointment(AppointmentModel appt)
    {
        editingModel = new AppointmentModel
        {
            AppointmentID = appt.AppointmentID,
            PatientID = appt.PatientID,
            DoctorID = appt.DoctorID,
            PatientName = appt.PatientName,
            DoctorName = appt.DoctorName,
            Status = appt.Status,
            Type = appt.Type,
            DateTime = appt.DateTime
        };
        editingDateTime = appt.DateTime;
        isEditing = true;
    }

    private async Task SaveEdit()
    {
        isProcessing = true;
        isError = false;
        message = "";
        
        try
        {
            editingModel.DateTime = editingDateTime;
            DatabaseManager.GetInstance().UpdateAppointment(editingModel);
            
            message = $"✅ Appointment #{editingModel.AppointmentID} updated successfully";
            isError = false;
            isEditing = false;
            LoadData();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            message = $"❌ Error: {ex.Message}";
            isError = true;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private void CancelEdit()
    {
        isEditing = false;
        message = "";
    }

    private async Task ResendReminder(AppointmentModel appt)
    {
        isProcessing = true;
        isError = false;
        message = "";
        
        try
        {
            var db = DatabaseManager.GetInstance();
            var patient = db.GetUserById(appt.PatientID);
            
            if (patient == null)
            {
                throw new Exception("Patient not found");
            }

            if (string.IsNullOrEmpty(patient.Email) || string.IsNullOrEmpty(patient.PhoneNumber))
            {
                throw new Exception("Patient contact information is missing");
            }

            var timeUntil = appt.DateTime - DateTime.Now;
            var hoursUntil = (int)timeUntil.TotalHours;

            await NotificationService.SendAppointmentReminderAsync(
                patientName: patient.Name,
                patientEmail: patient.Email,
                patientPhone: patient.PhoneNumber,
                doctorName: appt.DoctorName,
                appointmentDate: appt.DateTime,
                appointmentType: appt.Type,
                hoursBeforeAppointment: hoursUntil > 0 ? hoursUntil : 0
            );

            // Update status to ReminderSent
            appt.Status = "ReminderSent";
            db.UpdateAppointment(appt);

            // Format time until appointment
            string timeText;
            if (timeUntil.TotalHours < 1)
                timeText = $"{(int)timeUntil.TotalMinutes} minutes";
            else if (timeUntil.TotalDays < 1)
                timeText = $"{(int)timeUntil.TotalHours} hours {timeUntil.Minutes} minutes";
            else
                timeText = $"{(int)timeUntil.TotalDays} days {timeUntil.Hours} hours";

            message = $"✅ Reminder sent to {patient.Name} (Email & WhatsApp) - Appointment in {timeText}";
            isError = false;
            LoadData();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            message = $"❌ Error sending reminder: {ex.Message}";
            isError = true;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private void CheckInPatient(AppointmentModel appt)
    {
        try
        {
            appt.Status = "CheckedIn";
            DatabaseManager.GetInstance().UpdateAppointment(appt);
            
            message = $"✅ Patient checked in for Appointment #{appt.AppointmentID}";
            isError = false;
            LoadData();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            message = $"❌ Error: {ex.Message}";
            isError = true;
        }
        
        StateHasChanged();
    }

    private void CompleteAppointment(AppointmentModel appt)
    {
        try
        {
            appt.Status = "Completed";
            DatabaseManager.GetInstance().UpdateAppointment(appt);
            
            message = $"✅ Appointment #{appt.AppointmentID} marked as completed";
            isError = false;
            LoadData();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            message = $"❌ Error: {ex.Message}";
            isError = true;
        }
        
        StateHasChanged();
    }

    private void CancelAppointment(AppointmentModel appt)
    {
        try
        {
            appt.Status = "Cancelled";
            DatabaseManager.GetInstance().UpdateAppointment(appt);
            
            message = $"✅ Appointment #{appt.AppointmentID} has been cancelled";
            isError = false;
            LoadData();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            message = $"❌ Error: {ex.Message}";
            isError = true;
        }
        
        StateHasChanged();
    }

    private void DeleteAppointment(int id)
    {
        isProcessing = true;
        
        try
        {
            DatabaseManager.GetInstance().DeleteAppointment(id);
            message = $"✅ Appointment #{id} deleted successfully";
            isError = false;
            LoadData();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            message = $"❌ Error deleting appointment: {ex.Message}";
            isError = true;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Confirmed" => "bg-success",
            "Pending" => "bg-warning",
            "Cancelled" => "bg-danger",
            "Completed" => "bg-secondary",
            "ReminderSent" => "bg-info",
            "CheckedIn" => "bg-primary",
            _ => "bg-secondary"
        };
    }

    private string GetTimeUntilClass(double hoursUntil)
    {
        if (hoursUntil < 0) return "badge bg-secondary"; // Past
        if (hoursUntil < 2) return "badge bg-danger";
        if (hoursUntil < 24) return "badge bg-warning";
        return "badge bg-success";
    }

    private string GetTimeUntilText(TimeSpan timeUntil)
    {
        // Handle past events
        if (timeUntil.TotalMinutes < 0)
        {
            var absTime = timeUntil.Negate();
            if (absTime.TotalHours < 1)
                return $"{(int)absTime.TotalMinutes}m ago";
            if (absTime.TotalDays < 1)
                return $"{(int)absTime.TotalHours}h {absTime.Minutes}m ago";
            return $"{(int)absTime.TotalDays}d {absTime.Hours}h {absTime.Minutes}m ago";
        }
        
        // Handle future events
        if (timeUntil.TotalHours < 1)
            return $"{(int)timeUntil.TotalMinutes}m";
        if (timeUntil.TotalDays < 1)
            return $"{(int)timeUntil.TotalHours}h {timeUntil.Minutes}m";
        
        return $"{(int)timeUntil.TotalDays}d {timeUntil.Hours}h {timeUntil.Minutes}m";
    }
}
