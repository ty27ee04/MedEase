@page "/receptionist-dashboard"
@rendermode InteractiveServer
@using HealthTech.Services
@using System.ComponentModel.DataAnnotations
@inject NavigationManager NavigationManager
@inject UserSession UserSession
@inject ApiService ApiService

<PageTitle>Receptionist Dashboard</PageTitle>

<div class="container mt-4">
    <h1 class="mb-4">👩‍💼 Receptionist Dashboard</h1>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link @(activeTab == "register" ? "active" : "")" @onclick='() => activeTab = "register"'
                style="cursor:pointer">
                ➕ Register New Patient
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(activeTab == "rooms" ? "active" : "")"
                @onclick='() => activeTab = "rooms"' style="cursor:pointer">
                🏥 Manage Rooms
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" @onclick='() => NavigationManager.NavigateTo("/upcoming-appointments")' style="cursor:pointer">
                📅 Manage Appointments
            </a>
        </li>
    </ul>

    <!-- ================= REGISTER PATIENT ================= -->
    @if (activeTab == "register")
    {
        <div class="card">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">➕ Register New Patient</h4>
            </div>

            <div class="card-body">

                <!-- 🔴 THIS IS THE IMPORTANT FIX -->
                <EditForm Model="newPatient" OnValidSubmit="RegisterNewPatient">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Full Name</label>
                            <InputText class="form-control" @bind-Value="newPatient.Name" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <InputText class="form-control" @bind-Value="newPatient.Email" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Phone</label>
                            <InputText class="form-control" @bind-Value="newPatient.Phone" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Age</label>
                            <InputNumber class="form-control" @bind-Value="newPatient.Age" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Gender</label>
                            <InputSelect class="form-select" @bind-Value="newPatient.Gender">
                                <option value="">-- Select --</option>
                                <option>Male</option>
                                <option>Female</option>
                                <option>Other</option>
                            </InputSelect>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success btn-lg">
                        ✅ Register Patient
                    </button>
                </EditForm>

                @if (!string.IsNullOrEmpty(registerMessage))
                {
                    <div class="alert alert-info mt-3">
                        @registerMessage
                    </div>
                }
            </div>
        </div>
    }

    <!-- ================= MANAGE ROOMS ================= -->
    @if (activeTab == "rooms")
    {
        <div class="card">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">🏥 Room Management</h4>
                <button class="btn btn-light" @onclick="ShowAddRoomModal">
                    ➕ Add New Room
                </button>
            </div>
            <div class="card-body">
                <!-- Rooms List -->
                @if (rooms.Count == 0)
                {
                    <div class="alert alert-info">No rooms found. Click "Add New Room" to create one.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Room Number</th>
                                    <th>Room Type</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var room in rooms.OrderBy(r => r.RoomNumber))
                                {
                                    <tr>
                                        <td><strong>@room.RoomNumber</strong></td>
                                        <td>@room.RoomType</td>
                                        <td>
                                            <span class="badge @(room.Status == "Available" ? "bg-success" : room.Status == "Unavailable" ? "bg-danger" : "bg-warning")">
                                                @room.Status
                                            </span>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ShowEditRoomModal(room)">
                                                ✏️ Edit
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteRoom(room.RoomID)">
                                                🗑️ Delete
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Room Add/Edit Modal -->
@if (showRoomModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingRoom != null ? "✏️ Edit Room" : "➕ Add New Room")</h5>
                    <button type="button" class="btn-close" @onclick="CloseRoomModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Room Number *</label>
                        <input class="form-control" @bind="roomNumber" placeholder="e.g., 101, A-201" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Room Type *</label>
                        <input class="form-control" @bind="roomType" placeholder="e.g., Consultation, Surgery, ICU" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Status *</label>
                        <select class="form-select" @bind="roomStatus">
                            <option value="Available">Available</option>
                            <option value="Unavailable">Unavailable</option>
                            <option value="Maintenance">Maintenance</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseRoomModal">Cancel</button>
                    @if (editingRoom != null)
                    {
                        <button class="btn btn-success" @onclick="UpdateRoom">💾 Update Room</button>
                    }
                    else
                    {
                        <button class="btn btn-primary" @onclick="AddRoom">➕ Add Room</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string activeTab = "register";  // Default to register tab

    private List<AppointmentModel> appointments = new();
    private List<Room> rooms = new();

    protected override async Task OnInitializedAsync()
    {
        appointments = await ApiService.GetAllAppointmentsAsync();
        await LoadRooms();
    }

    private async Task DeleteAppointment(int id)
    {
        await ApiService.DeleteAppointmentAsync(id);
        appointments = await ApiService.GetAllAppointmentsAsync();
    }

    // ================= ROOM MANAGEMENT =================
    
    private string roomNumber = "";
    private string roomType = "";
    private string roomStatus = "Available";
    private Room? editingRoom = null;
    private bool showRoomModal = false;
    
    private async Task LoadRooms()
    {
        rooms = await ApiService.GetAllRoomsAsync();
    }
    
    private void ShowAddRoomModal()
    {
        editingRoom = null;
        roomNumber = "";
        roomType = "";
        roomStatus = "Available";
        showRoomModal = true;
    }
    
    private void ShowEditRoomModal(Room room)
    {
        editingRoom = room;
        roomNumber = room.RoomNumber;
        roomType = room.RoomType;
        roomStatus = room.Status;
        showRoomModal = true;
    }
    
    private void CloseRoomModal()
    {
        showRoomModal = false;
        editingRoom = null;
        roomNumber = "";
        roomType = "";
        roomStatus = "Available";
    }
    
    private async Task AddRoom()
    {
        if (string.IsNullOrWhiteSpace(roomNumber) || string.IsNullOrWhiteSpace(roomType))
        {
            registerMessage = "❌ Room Number and Room Type are required.";
            return;
        }
        
        var newRoom = new Room
        {
            RoomNumber = roomNumber,
            RoomType = roomType,
            Status = roomStatus
        };
        
        await ApiService.SaveRoomAsync(newRoom);
        registerMessage = $"✅ Room {roomNumber} added successfully.";
        
        CloseRoomModal();
        await LoadRooms();
    }
    
    private async Task UpdateRoom()
    {
        if (editingRoom == null) return;
        
        if (string.IsNullOrWhiteSpace(roomNumber) || string.IsNullOrWhiteSpace(roomType))
        {
            registerMessage = "❌ Room Number and Room Type are required.";
            return;
        }
        
        editingRoom.RoomNumber = roomNumber;
        editingRoom.RoomType = roomType;
        editingRoom.Status = roomStatus;
        
        await ApiService.UpdateRoomAsync(editingRoom);
        registerMessage = $"✅ Room {roomNumber} updated successfully.";
        
        CloseRoomModal();
        await LoadRooms();
    }
    
    private async Task DeleteRoom(int roomId)
    {
        await ApiService.DeleteRoomAsync(roomId);
        registerMessage = "✅ Room deleted successfully.";
        await LoadRooms();
    }

    // ================= REGISTER =================

    private PatientRegistration newPatient = new();
    private string registerMessage = "";

    private async Task RegisterNewPatient()
    {
        Console.WriteLine("REGISTER CLICKED"); // debug proof

        int id = await ApiService.RegisterPatientAsync(
            newPatient.Name,
            newPatient.Email,
            "DefaultPassword123",  // Default password - patient can change later
            newPatient.Phone,
            newPatient.Age,
            newPatient.Gender
        );

        registerMessage = $"✅ Patient registered successfully. ID: {id}";
        
        newPatient = new PatientRegistration();
    }

    private class PatientRegistration
    {
        [Required]
        public string Name { get; set; } = "";

        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        public string Phone { get; set; } = "";

        public int? Age { get; set; }
        public string Gender { get; set; } = "";
    }
}