@page "/doctor"
@rendermode InteractiveServer
@inject NavigationManager Nav

<div class="dashboard-wrap">
    <h3 class="page-title">Doctor Dashboard</h3>
    <p class="page-subtitle">Quick overview of today's clinic operations.</p>

    <div class="kpi-grid">
        <!-- KPI Card 1 -->
        <div class="kpi-card">
            <div class="kpi-header">
                <span class="kpi-label">Today's Appointments</span>
                <span class="kpi-badge badge-blue">Today</span>
            </div>
            <div class="kpi-value">@TodayAppointments</div>
            <div class="kpi-hint">Total scheduled consultations.</div>
        </div>

        <!-- KPI Card 2 -->
        <div class="kpi-card">
            <div class="kpi-header">
                <span class="kpi-label">Completed Consultations</span>
                <span class="kpi-badge badge-green">Done</span>
            </div>
            <div class="kpi-value">@CompletedConsultations</div>
            <div class="kpi-hint">Patients already served today.</div>
        </div>

        <!-- KPI Card 3 -->
        <div class="kpi-card">
            <div class="kpi-header">
                <span class="kpi-label">Pending Lab Reports</span>
                <span class="kpi-badge badge-orange">Pending</span>
            </div>
            <div class="kpi-value">@PendingLabReports</div>
            <div class="kpi-hint">Reports waiting for review.</div>
        </div>

        <!-- KPI Card 4 -->
        <div class="kpi-card">
            <div class="kpi-header">
                <span class="kpi-label">New Notifications</span>
                <span class="kpi-badge badge-purple">Alerts</span>
            </div>
            <div class="kpi-value">@NewNotifications</div>
            <div class="kpi-hint">Updates from appointments & system.</div>
        </div>
    </div>

    <div class="section-grid">
        <!-- LEFT: Upcoming + Recent -->
        <div class="left-stack">

            <!-- Upcoming Appointments -->
            <div class="panel">
                <div class="panel-title">Upcoming Appointments</div>

                @if (UpcomingAppointments == null || UpcomingAppointments.Count == 0)
                {
                    <div class="empty">No upcoming appointments.</div>
                }
                else
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Patient</th>
                                <th>Reason</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in UpcomingAppointments)
                            {
                                <tr class="row-click" @onclick="GoPatientRecords">
                                    <td>@a.Time</td>
                                    <td>@a.PatientName</td>
                                    <td>@a.Reason</td>
                                    <td>
                                        <span class="status @GetStatusClass(a.Status)">@a.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="tiny-note">
                        Tip: Click any appointment row to open Patient Records.
                    </div>
                }
            </div>

            <!-- Recent Patient Records -->
            <div class="panel" style="margin-top:14px;">
                <div class="panel-title">Recent Patient Records</div>

                @if (RecentRecords == null || RecentRecords.Count == 0)
                {
                    <div class="empty">No recent records.</div>
                }
                else
                {
                    <div class="records-grid">
                        @foreach (var r in RecentRecords)
                        {
                            <div class="record-card" @onclick="GoPatientRecords">
                                <div class="record-top">
                                    <div class="record-name">@r.PatientName</div>
                                    <div class="record-date">@r.LastVisit</div>
                                </div>
                                <div class="record-note">@r.Note</div>
                                <div class="record-meta">Doctor: @r.DoctorName</div>
                            </div>
                        }
                    </div>

                    <div class="tiny-note">
                        Tip: Click a record card to open Patient Records.
                    </div>
                }
            </div>
        </div>

        <!-- RIGHT: Quick Actions -->
        <div class="panel">
            <div class="panel-title">Quick Actions</div>

            <button class="btn" @onclick="RefreshDashboard">Refresh Dashboard</button>
            <button class="btn btn-outline" @onclick="MarkAllNotificationsRead">Mark Notifications as Read</button>

            <div class="notice">
                <div class="notice-title">Tip</div>
                <div class="notice-text">
                    This dashboard uses sample data for now. Next step: connect to DB/services.
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-wrap {
        max-width: 1200px;
        margin: 0 auto;
        padding: 14px;
    }

    .page-title {
        margin: 6px 0 4px;
        font-weight: 800;
    }

    .page-subtitle {
        margin: 0 0 14px;
        opacity: 0.85;
    }

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(180px, 1fr));
        gap: 14px;
        margin-bottom: 16px;
    }

    .kpi-card {
        border: 1px solid rgba(0,0,0,0.12);
        border-radius: 10px;
        padding: 14px;
        background: #fff;
        box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    }

    .kpi-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .kpi-label {
        font-weight: 650;
        opacity: 0.85;
    }

    .kpi-value {
        font-size: 30px;
        font-weight: 850;
        line-height: 1;
        margin-bottom: 6px;
    }

    .kpi-hint {
        font-size: 12px;
        opacity: 0.75;
    }

    .kpi-badge {
        font-size: 11px;
        padding: 4px 8px;
        border-radius: 999px;
        color: #fff;
        font-weight: 800;
    }

    .badge-blue {
        background: #2d6cdf;
    }

    .badge-green {
        background: #1f9d55;
    }

    .badge-orange {
        background: #f59e0b;
    }

    .badge-purple {
        background: #7c3aed;
    }

    .section-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 14px;
        align-items: start;
    }

    .left-stack {
        display: flex;
        flex-direction: column;
    }

    .panel {
        border: 1px solid rgba(0,0,0,0.12);
        border-radius: 10px;
        padding: 14px;
        background: #fff;
        box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    }

    .panel-title {
        font-weight: 850;
        margin-bottom: 10px;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
    }

        .table th, .table td {
            padding: 10px 8px;
            border-bottom: 1px solid rgba(0,0,0,0.08);
        }

        .table th {
            text-align: left;
            opacity: 0.8;
            font-size: 13px;
        }

    .status {
        font-size: 12px;
        padding: 4px 8px;
        border-radius: 999px;
        font-weight: 800;
        display: inline-block;
        white-space: nowrap;
    }

        .status.scheduled {
            background: rgba(45,108,223,0.12);
            color: #2d6cdf;
        }

        .status.checked-in {
            background: rgba(31,157,85,0.12);
            color: #1f9d55;
        }

        .status.waiting {
            background: rgba(245,158,11,0.12);
            color: #b45309;
        }

    .row-click {
        cursor: pointer;
    }

        .row-click:hover {
            background: rgba(0,0,0,0.04);
        }

    .records-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(180px, 1fr));
        gap: 12px;
    }

    .record-card {
        border: 1px solid rgba(0,0,0,0.10);
        border-radius: 10px;
        padding: 12px;
        background: #fff;
        cursor: pointer;
    }

        .record-card:hover {
            background: rgba(0,0,0,0.03);
        }

    .record-top {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 6px;
    }

    .record-name {
        font-weight: 850;
    }

    .record-date {
        font-size: 12px;
        opacity: 0.75;
        white-space: nowrap;
    }

    .record-note {
        font-size: 13px;
        opacity: 0.9;
        margin-bottom: 8px;
    }

    .record-meta {
        font-size: 12px;
        opacity: 0.75;
    }

    .tiny-note {
        margin-top: 10px;
        font-size: 12px;
        opacity: 0.75;
    }

    .btn {
        width: 100%;
        padding: 10px 12px;
        border-radius: 10px;
        border: 1px solid rgba(0,0,0,0.15);
        background: #111827;
        color: #fff;
        font-weight: 800;
        cursor: pointer;
        margin-bottom: 10px;
    }

        .btn:hover {
            opacity: 0.92;
        }

    .btn-outline {
        background: #fff;
        color: #111827;
    }

    .notice {
        margin-top: 12px;
        padding: 12px;
        border-radius: 10px;
        background: rgba(45,108,223,0.08);
        border: 1px solid rgba(45,108,223,0.18);
    }

    .notice-title {
        font-weight: 850;
        margin-bottom: 6px;
    }

    .notice-text {
        font-size: 13px;
        opacity: 0.9;
    }

    .empty {
        opacity: 0.7;
        padding: 10px 0;
    }

    /* Responsive */
    @@media (max-width: 1100px) {
        .kpi-grid {
            grid-template-columns: repeat(2, minmax(180px, 1fr));
        }

        .section-grid {
            grid-template-columns: 1fr;
        }

        .records-grid {
            grid-template-columns: repeat(2, minmax(180px, 1fr));
        }
    }

    @@media (max-width: 700px) {
        .records-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    // Fake KPI data (later we can connect to DB)
    private int TodayAppointments = 12;
    private int CompletedConsultations = 7;
    private int PendingLabReports = 3;
    private int NewNotifications = 2;

    // Upcoming appointments (sample)
    private List<AppointmentItem> UpcomingAppointments = new()
    {
        new AppointmentItem("09:30", "Alice Tan", "Follow-up", "Scheduled"),
        new AppointmentItem("10:15", "Lim Wei", "Fever / Flu", "Waiting"),
        new AppointmentItem("11:00", "Kumar Raj", "Blood Test Review", "Checked-in"),
        new AppointmentItem("14:20", "Nur Aina", "Skin Rash", "Scheduled"),
    };

    // Recent records (sample)
    private List<RecordItem> RecentRecords = new()
    {
        new RecordItem("Kumar Raj", "2026-01-07", "Blood test reviewed. Follow-up in 2 weeks.", "Dr. Wong"),
        new RecordItem("Alice Tan", "2026-01-07", "Follow-up completed. Stable condition.", "Dr. Wong"),
        new RecordItem("Nur Aina", "2026-01-06", "Skin rash prescribed topical cream.", "Dr. Lim"),
    };

    // ✅ safest: navigate without parameters
    private void GoPatientRecords()
    {
        Nav.NavigateTo("/patient-records");
    }

    private void RefreshDashboard()
    {
        TodayAppointments += 1;
        NewNotifications += 1;
    }

    private void MarkAllNotificationsRead()
    {
        NewNotifications = 0;
    }

    private string GetStatusClass(string? status)
    {
        status ??= "Scheduled";
        return status.Trim().ToLowerInvariant() switch
        {
            "scheduled" => "scheduled",
            "checked-in" => "checked-in",
            "checked in" => "checked-in",
            "waiting" => "waiting",
            _ => "scheduled"
        };
    }

    private record AppointmentItem(string Time, string PatientName, string Reason, string Status);
    private record RecordItem(string PatientName, string LastVisit, string Note, string DoctorName);
}
