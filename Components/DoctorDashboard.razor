@page "/doctor"
@inject NavigationManager Nav
@rendermode InteractiveServer


<div class="dashboard-wrap">
    <h3 class="page-title">Doctor Dashboard</h3>
    <p class="page-subtitle">Working settings + today schedule + quick access to patient records (mock data for now).</p>

    <!-- (1) Working time + Day off + On Leave -->
    <div class="panel">
        <div class="panel-title">Working Settings</div>

        <div class="form-grid">
            <div class="field">
                <label class="label">Working Start</label>
                <input class="input" type="time" @bind="WorkingStart" />
            </div>

            <div class="field">
                <label class="label">Working End</label>
                <input class="input" type="time" @bind="WorkingEnd" />
            </div>

            <div class="field">
                <label class="label">Day Off (Weekly)</label>
                <select class="input" @bind="DayOff">
                    @foreach (var d in WeekDays)
                    {
                        <option value="@d">@d</option>
                    }
                </select>
            </div>

            <div class="field">
                <label class="label">On Leave?</label>
                <div class="toggle-row">
                    <input type="checkbox" @bind="IsOnLeave" />
                    <span class="hint">Enable if doctor is on leave for a period</span>
                </div>
            </div>

            <div class="field">
                <label class="label">Leave Start</label>
                <input class="input" type="date" @bind="LeaveStartDate" />
            </div>

            <div class="field">
                <label class="label">Leave End</label>
                <input class="input" type="date" @bind="LeaveEndDate" />
            </div>
        </div>

        <div class="actions-row">
            <button class="btn" @onclick="SaveWorkingSettings">Save Settings</button>
            <div class="saved-hint">@SaveMessage</div>
        </div>
    </div>

    <!-- KPI -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-header">
                <span class="kpi-label">Today's Appointments</span>
                <span class="kpi-badge badge-blue">Today</span>
            </div>
            <div class="kpi-value">@TodayAppointments</div>
            <div class="kpi-hint">Total scheduled consultations.</div>
        </div>

        <div class="kpi-card">
            <div class="kpi-header">
                <span class="kpi-label">Completed</span>
                <span class="kpi-badge badge-green">Done</span>
            </div>
            <div class="kpi-value">@CompletedConsultations</div>
            <div class="kpi-hint">Patients already served today.</div>
        </div>

        <div class="kpi-card">
            <div class="kpi-header">
                <span class="kpi-label">Pending Reviews</span>
                <span class="kpi-badge badge-orange">Pending</span>
            </div>
            <div class="kpi-value">@PendingLabReports</div>
            <div class="kpi-hint">Reports / lab results waiting review.</div>
        </div>

        <div class="kpi-card">
            <div class="kpi-header">
                <span class="kpi-label">Doctor Status</span>
                <span class="kpi-badge badge-purple">@DoctorStatusBadge</span>
            </div>
            <div class="kpi-value">@DoctorStatusValue</div>
            <div class="kpi-hint">@DoctorStatusHint</div>
        </div>
    </div>

    <!-- (2) Today schedule + edit appointment date/time -->
    <div class="panel">
        <div class="panel-title">Today Patient Schedule</div>

        @if (TodaySchedule == null || TodaySchedule.Count == 0)
        {
            <div class="empty">No appointments for today.</div>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th style="width:120px;">Time</th>
                        <th>Patient</th>
                        <th>Reason</th>
                        <th style="width:140px;">Status</th>
                        <th style="width:260px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in TodaySchedule)
                    {
                        var isEditing = (EditingPatientId == a.PatientId);

                        <tr>
                            <td>
                                @if (!isEditing)
                                {
                                    @a.AppointmentDateTime.ToString("HH:mm")
                                }
                                else
                                {
                                    <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                                        <input class="input" type="date" @bind="InlineEditDate" />
                                        <input class="input" type="time" @bind="InlineEditTime" />
                                    </div>
                                }
                            </td>

                            <td>
                                <span style="font-weight:700;">@a.PatientName</span>
                                <span class="muted">(ID: @a.PatientId)</span>
                            </td>

                            <td>@a.Reason</td>

                            <td>
                                <span class="status @GetStatusClass(a.Status)">@a.Status</span>
                            </td>

                            <td class="actions-cell">
                                @if (!isEditing)
                                {
                                    <button class="btn-sm" @onclick="() => StartInlineEdit(a)">Edit Date/Time</button>

                                    <button class="btn-sm btn-sm-outline"
                                            @onclick="() => GoPatientRecords(a.PatientId)">
                                        Patient Records / Add Diagnosis
                                    </button>
                                }
                                else
                                {
                                    <button class="btn-sm" @onclick="SaveInlineEdit">Save</button>
                                    <button class="btn-sm btn-sm-outline" @onclick="CancelInlineEdit">Cancel</button>

                                    <div class="tiny-note" style="margin-top:6px;">
                                        @InlineEditMessage
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

            <div class="tiny-note">
                Tip: Edit appointment date/time uses mock update now. Later replace with DB update.
            </div>
        }
    </div>

    

</div>

<style>
    .dashboard-wrap {
        max-width: 1200px;
        margin: 0 auto;
        padding: 14px;
    }

    .page-title {
        margin: 6px 0 4px;
        font-weight: 800;
    }

    .page-subtitle {
        margin: 0 0 14px;
        opacity: 0.85;
    }

    .panel {
        border: 1px solid rgba(0,0,0,0.12);
        border-radius: 10px;
        padding: 14px;
        background: #fff;
        box-shadow: 0 1px 2px rgba(0,0,0,0.04);
        margin-bottom: 14px;
    }

    .panel-title {
        font-weight: 850;
        margin-bottom: 10px;
    }

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(180px, 1fr));
        gap: 14px;
        margin-bottom: 14px;
    }

    .kpi-card {
        border: 1px solid rgba(0,0,0,0.12);
        border-radius: 10px;
        padding: 14px;
        background: #fff;
        box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    }

    .kpi-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .kpi-label {
        font-weight: 650;
        opacity: 0.85;
    }

    .kpi-value {
        font-size: 28px;
        font-weight: 850;
        line-height: 1;
        margin-bottom: 6px;
    }

    .kpi-hint {
        font-size: 12px;
        opacity: 0.75;
    }

    .kpi-badge {
        font-size: 11px;
        padding: 4px 8px;
        border-radius: 999px;
        color: #fff;
        font-weight: 800;
    }

    .badge-blue {
        background: #2d6cdf;
    }

    .badge-green {
        background: #1f9d55;
    }

    .badge-orange {
        background: #f59e0b;
    }

    .badge-purple {
        background: #7c3aed;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
    }

        .table th, .table td {
            padding: 10px 8px;
            border-bottom: 1px solid rgba(0,0,0,0.08);
            vertical-align: middle;
        }

        .table th {
            text-align: left;
            opacity: 0.8;
            font-size: 13px;
        }

    .status {
        font-size: 12px;
        padding: 4px 8px;
        border-radius: 999px;
        font-weight: 800;
        display: inline-block;
        white-space: nowrap;
    }

        .status.scheduled {
            background: rgba(45,108,223,0.12);
            color: #2d6cdf;
        }

        .status.checked-in {
            background: rgba(31,157,85,0.12);
            color: #1f9d55;
        }

        .status.waiting {
            background: rgba(245,158,11,0.12);
            color: #b45309;
        }

        .status.done {
            background: rgba(124,58,237,0.10);
            color: #7c3aed;
        }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(180px, 1fr));
        gap: 12px;
    }

    .modal-grid {
        grid-template-columns: repeat(2, minmax(180px, 1fr));
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .label {
        font-size: 12px;
        font-weight: 800;
        opacity: 0.85;
    }

    .input {
        border: 1px solid rgba(0,0,0,0.18);
        border-radius: 10px;
        padding: 10px 12px;
        outline: none;
    }

        .input:focus {
            border-color: rgba(45,108,223,0.6);
        }

    .hint {
        font-size: 12px;
        opacity: 0.7;
    }

    .toggle-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 0;
    }

    .actions-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 12px;
    }

    .saved-hint {
        font-size: 13px;
        opacity: 0.8;
    }

    .btn {
        padding: 10px 12px;
        border-radius: 10px;
        border: 1px solid rgba(0,0,0,0.15);
        background: #111827;
        color: #fff;
        font-weight: 800;
        cursor: pointer;
    }

        .btn:hover {
            opacity: 0.92;
        }

    .btn-sm {
        padding: 8px 10px;
        border-radius: 10px;
        border: 1px solid rgba(0,0,0,0.15);
        background: #111827;
        color: #fff;
        font-weight: 800;
        cursor: pointer;
        font-size: 12px;
    }

        .btn-sm:hover {
            opacity: 0.92;
        }

    .btn-sm-outline {
        background: #fff;
        color: #111827;
    }

    .actions-cell {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .tiny-note {
        margin-top: 10px;
        font-size: 12px;
        opacity: 0.7;
    }

    .muted {
        font-size: 12px;
        opacity: 0.65;
        margin-left: 6px;
    }

    .empty {
        opacity: 0.7;
        padding: 10px 0;
    }

    /* Modal */
    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        z-index: 9999;
    }

    .modal {
        width: min(680px, 100%);
        background: #fff;
        border-radius: 14px;
        border: 1px solid rgba(0,0,0,0.12);
        box-shadow: 0 10px 30px rgba(0,0,0,0.25);
        padding: 14px;
    }

    .modal-title {
        font-weight: 900;
        margin-bottom: 10px;
    }

    .modal-body {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .read {
        padding: 10px 12px;
        border-radius: 10px;
        background: rgba(0,0,0,0.04);
        border: 1px solid rgba(0,0,0,0.06);
    }

    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 12px;
    }

    /* Responsive */
    @@media (max-width: 1100px) {
        .kpi-grid {
            grid-template-columns: repeat(2, minmax(180px, 1fr));
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .modal-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    //  (1) Working settings (mock)
    private TimeOnly WorkingStart = new(9, 0);
    private TimeOnly WorkingEnd = new(17, 0);
    private string DayOff = "Sunday";
    private bool IsOnLeave = false;
    private DateTime LeaveStartDate = DateTime.Today;
    private DateTime LeaveEndDate = DateTime.Today.AddDays(1);

    private readonly List<string> WeekDays = new()
    {
        "Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"
    };

    private string SaveMessage = "";

    private void SaveWorkingSettings()
    {
        // mock save (later replace with DB)
        SaveMessage =
            $"Saved: {WorkingStart:HH\\:mm}-{WorkingEnd:HH\\:mm}, Day Off: {DayOff}, On Leave: " +
            (IsOnLeave ? $"{LeaveStartDate:yyyy-MM-dd} to {LeaveEndDate:yyyy-MM-dd}" : "No");
    }

    // Doctor status KPI
    private string DoctorStatusBadge => IsOnLeave ? "On Leave" : "Active";
    private string DoctorStatusValue => IsOnLeave ? "OFF" : $"{WorkingStart:HH\\:mm}-{WorkingEnd:HH\\:mm}";
    private string DoctorStatusHint => IsOnLeave
        ? $"Leave: {LeaveStartDate:MM/dd} - {LeaveEndDate:MM/dd}"
        : $"Day Off: {DayOff}";

    //  KPI (mock)
    private int TodayAppointments => TodaySchedule?.Count ?? 0;
    private int CompletedConsultations = 7;
    private int PendingLabReports = 3;

    //  (2) Today schedule (mock) 
    private List<AppointmentRow> TodaySchedule = new()
    {
        new AppointmentRow("P-90210", "John Doe", DateTime.Today.AddHours(9).AddMinutes(30), "Follow-up", "Scheduled"),
        new AppointmentRow("P-10021", "Alice Tan", DateTime.Today.AddHours(10).AddMinutes(15), "Fever / Flu", "Waiting"),
        new AppointmentRow("P-77102", "Kumar Raj", DateTime.Today.AddHours(11).AddMinutes(0), "Blood Test Review", "Checked-in"),
        new AppointmentRow("P-55219", "Nur Aina", DateTime.Today.AddHours(14).AddMinutes(20), "Skin Rash", "Scheduled"),
    };

    private string GetStatusClass(string? status)
    {
        status ??= "Scheduled";
        return status.Trim().ToLowerInvariant() switch
        {
            "scheduled" => "scheduled",
            "checked-in" => "checked-in",
            "checked in" => "checked-in",
            "waiting" => "waiting",
            "done" => "done",
            _ => "scheduled"
        };
    }

    // ====== (2) Edit appointment modal ======
    private bool IsEditModalOpen = false;
    private AppointmentRow? EditingAppointment;
    private DateTime EditDate = DateTime.Today;
    private TimeOnly EditTime = new(9, 0);
    private string ModalMessage = "";

    private void OpenEditModal(AppointmentRow a)
    {
        EditingAppointment = a;
        EditDate = a.AppointmentDateTime.Date;
        EditTime = TimeOnly.FromDateTime(a.AppointmentDateTime);
        ModalMessage = "";
        IsEditModalOpen = true;
    }

    private void CloseEditModal()
    {
        IsEditModalOpen = false;
        EditingAppointment = null;
        ModalMessage = "";
    }

    private void SaveEditAppointment()
    {
        if (EditingAppointment == null) return;

        // Combine date + time safely
        var newDt = EditDate.Date.Add(EditTime.ToTimeSpan());
        EditingAppointment.AppointmentDateTime = newDt;

        ModalMessage = $"Updated appointment to {newDt:yyyy-MM-dd HH:mm} (mock).";
        // keep modal open so user can see message; user can close manually
    }

    // ====== (3) Link to patient records / add diagnosis ======
    private void GoPatientRecords(string patientId)
    {
        Nav.NavigateTo($"/patient-records?patientId={Uri.EscapeDataString(patientId)}");
    }

    private class AppointmentRow
    {
        public AppointmentRow(string patientId, string patientName, DateTime dt, string reason, string status)
        {
            PatientId = patientId;
            PatientName = patientName;
            AppointmentDateTime = dt;
            Reason = reason;
            Status = status;
        }

        public string PatientId { get; set; }
        public string PatientName { get; set; }
        public DateTime AppointmentDateTime { get; set; }
        public string Reason { get; set; }
        public string Status { get; set; }
    }

    // ===== Inline Edit (Method A) =====
    private string? EditingPatientId = null;       
    private AppointmentRow? EditingRow = null;     

    private DateTime InlineEditDate = DateTime.Today;
    private TimeOnly InlineEditTime = new(9, 0);
    private string InlineEditMessage = "";

    private void StartInlineEdit(AppointmentRow a)
    {
        EditingPatientId = a.PatientId;
        EditingRow = a;

        InlineEditDate = a.AppointmentDateTime.Date;
        InlineEditTime = TimeOnly.FromDateTime(a.AppointmentDateTime);

        InlineEditMessage = "";
    }

    private void CancelInlineEdit()
    {
        EditingPatientId = null;
        EditingRow = null;
        InlineEditMessage = "";
    }

    private async Task SaveInlineEdit()
    {
        if (EditingRow == null) return;

        var newDt = InlineEditDate.Date.Add(InlineEditTime.ToTimeSpan());
        EditingRow.AppointmentDateTime = newDt;

        InlineEditMessage = $"Updated to {newDt:yyyy-MM-dd HH:mm} (mock).";

        await Task.Delay(800);

        EditingPatientId = null;
        EditingRow = null;
        InlineEditMessage = "";
    }


}
